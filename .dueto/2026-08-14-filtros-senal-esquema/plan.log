 298:             { x: x1, y: y1 },
 299:             { x: carrilX, y: y1 },
 300:             { x: carrilX, y: y2 },
 301:             { x: x2, y: y2 },
 302:           ];
 303: 
 304:     lineas.push({
 305:       conexion_id: c.id,
 306:       identificador: identificadores.get(c.id) ?? '—',
 307:       senal: c.senal,
 308:       puntos,
