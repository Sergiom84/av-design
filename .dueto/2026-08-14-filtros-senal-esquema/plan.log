 163: function filasDeBloque(
 164:   puertos: Puerto[],
 165:   usados: Set<string>,
 166:   soloConectados: boolean,
 167: ): { izquierda: Puerto[]; derecha: Puerto[] } {
 168:   const visibles = soloConectados ? puertos.filter((p) => usados.has(p.id)) : puertos;
 169:   const ordenados = [...visibles].sort(
 170:     (a, b) => (a.orden ?? 999) - (b.orden ?? 999) || (a.nombre < b.nombre ? -1 : 1),
 171:   );
 172:   return {
 173:     izquierda: ordenados.filter((p) => ladoDePuerto(p.sentido) === 'izquierda'),
 174:     derecha: ordenados.filter((p) => ladoDePuerto(p.sentido) === 'derecha'),
 175:   };
 176: }
