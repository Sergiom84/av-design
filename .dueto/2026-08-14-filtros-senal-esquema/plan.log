 145: /**
 146:  * Columna de cada equipo según su papel en el flujo de señal: quien solo
 147:  * emite a la izquierda, quien emite y recibe en medio, quien solo recibe a la
 148:  * derecha. Los equipos sin conexión van a la última columna, que es donde
 149:  * menos estorban sin desaparecer: siguen siendo material de la sala.
 150:  */
 151: export function columnaDeEquipo(
 152:   equipoId: string,
 153:   conexiones: Conexion[],
 154: ): 0 | 1 | 2 | 3 {
 155:   const emite = conexiones.some((c) => c.origen_id === equipoId);
 156:   const recibe = conexiones.some((c) => c.destino_id === equipoId);
 157:   if (emite && recibe) return 1;
 158:   if (emite) return 0;
 159:   if (recibe) return 2;
 160:   return 3;
 161: }
