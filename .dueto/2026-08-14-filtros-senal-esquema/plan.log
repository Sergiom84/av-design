 121: /**
 122:  * Etiqueta única por equipo. Dos pantallas iguales necesitan distinguirse en
 123:  * el plano (`Pantalla 1`, `Pantalla 2`); el sufijo se asigna por orden de id,
 124:  * que es inmutable, y **no se renumera** al borrar: mismo criterio que el
 125:  * identificador de cable, que puede estar ya escrito en una brida.
 126:  */
 127: export function etiquetasDeEquipos(equipos: EquipoEnSala[]): Map<string, string> {
 128:   const porNombre = new Map<string, EquipoEnSala[]>();
 129:   for (const e of [...equipos].sort((a, b) => (a.id < b.id ? -1 : 1))) {
 130:     const lista = porNombre.get(e.nombre) ?? [];
 131:     lista.push(e);
 132:     porNombre.set(e.nombre, lista);
 133:   }
 134:   const etiquetas = new Map<string, string>();
 135:   for (const [nombre, lista] of porNombre) {
 136:     if (lista.length === 1) {
 137:       etiquetas.set(lista[0].id, nombre);
 138:     } else {
 139:       lista.forEach((e, i) => etiquetas.set(e.id, `${nombre} ${i + 1}`));
 140:     }
 141:   }
 142:   return etiquetas;
 143: }
