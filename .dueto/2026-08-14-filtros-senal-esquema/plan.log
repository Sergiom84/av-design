 178: export function construirDiagrama(entrada: EntradaDiagrama): EscenaDiagrama {
 179:   const m = MEDIDAS_DIAGRAMA;
 180:   const {
 181:     equipos,
 182:     puertosPorArticulo,
 183:     conexiones,
 184:     descripcionArticulo,
 185:     categoriaArticulo,
