 110:   descripcionArticulo?: Map<string, string>;
 111:   /** Categoría por artículo, para el rótulo sobre el bloque. */
 112:   categoriaArticulo?: Map<string, string>;
 113:   /**
 114:    * `true`: solo se pintan los puertos con cable, el "Hide Unused Connectors"
 115:    * de XTEN-AV. Con una matriz de veinte puertos el esquema es ilegible sin
 116:    * esto, así que es el modo por defecto de la interfaz.
 117:    */
 118:   soloConectados?: boolean;
