 147:     const codec = porId.get('e-codec')!;
 148:     const tv = porId.get('e-tv')!;
 149:     assert.ok(caja.x < codec.x, 'la caja emite: columna anterior al códec');
 150:     assert.ok(codec.x < tv.x, 'la pantalla solo recibe: última columna');
 151:   });
 152: 
 153:   it('reparte los puertos del bloque entre entradas y salidas', () => {
 154:     const escena = construirDiagrama(entradaTipo());
