  53: export interface FilaPuertoDiagrama {
  54:   puerto_id: string;
  55:   /** El literal del fabricante: `HDMI IN 1`. */
  56:   nombre: string;
  57:   /** `RJ45`, `HDMI A`… Se pinta fuera del borde, como XTEN-AV. */
  58:   conector: string | null;
  59:   senal: Senal;
  60:   /** `×4` cuando la fila representa varios puertos iguales. */
  61:   total: number;
  62:   conectado: boolean;
  63:   /** Centro vertical de la fila, absoluto en el dibujo. */
  64:   y: number;
  65: }
  66: 
  67: export interface BloqueDiagrama {
  68:   equipo_id: string;
  69:   /** Nombre del equipo, con sufijo cuando hay repetidos: `Pantalla 2`. */
  70:   etiqueta: string;
  71:   /** Rótulo de categoría sobre el bloque: el `DISPLAY` de XTEN-AV. */
  72:   categoria: string | null;
  73:   /** Marca y modelo al pie, si el artículo se conoce. */
  74:   marca_modelo: string | null;
  75:   x: number;
  76:   y: number;
  77:   ancho: number;
  78:   alto: number;
  79:   entradas: FilaPuertoDiagrama[];
  80:   salidas: FilaPuertoDiagrama[];
  81: }
  82: 
  83: export interface LineaDiagrama {
  84:   conexion_id: string;
  85:   /** `HD-1000`, el mismo de la tabla de cables y de la brida. */
  86:   identificador: string;
  87:   senal: Senal;
  88:   /** Vértices de la polilínea ortogonal, de origen a destino. */
  89:   puntos: { x: number; y: number }[];
  90:   /** Dónde va la etiqueta del identificador. */
  91:   etiqueta_x: number;
  92:   etiqueta_y: number;
  93: }
  94: 
  95: export interface EscenaDiagrama {
  96:   bloques: BloqueDiagrama[];
  97:   lineas: LineaDiagrama[];
  98:   ancho: number;
  99:   alto: number;
 100:   /** Conexiones que no se pudieron dibujar (extremo sin equipo en la sala). */
 101:   omitidas: number;
 102: }
 103: 
 104: export interface EntradaDiagrama {
 105:   equipos: EquipoEnSala[];
 106:   /** Puertos del catálogo de los artículos presentes, indexados por artículo. */
 107:   puertosPorArticulo: Map<string, Puerto[]>;
 108:   conexiones: Conexion[];
 109:   /** Marca y modelo por artículo, para el pie del bloque. */
 110:   descripcionArticulo?: Map<string, string>;
 111:   /** Categoría por artículo, para el rótulo sobre el bloque. */
 112:   categoriaArticulo?: Map<string, string>;
 113:   /**
 114:    * `true`: solo se pintan los puertos con cable, el "Hide Unused Connectors"
 115:    * de XTEN-AV. Con una matriz de veinte puertos el esquema es ilegible sin
 116:    * esto, así que es el modo por defecto de la interfaz.
 117:    */
 118:   soloConectados?: boolean;
 119: }
 120: 
 121: /**
 122:  * Etiqueta única por equipo. Dos pantallas iguales necesitan distinguirse en
 123:  * el plano (`Pantalla 1`, `Pantalla 2`); el sufijo se asigna por orden de id,
 124:  * que es inmutable, y **no se renumera** al borrar: mismo criterio que el
 125:  * identificador de cable, que puede estar ya escrito en una brida.
 126:  */
 127: export function etiquetasDeEquipos(equipos: EquipoEnSala[]): Map<string, string> {
 128:   const porNombre = new Map<string, EquipoEnSala[]>();
 129:   for (const e of [...equipos].sort((a, b) => (a.id < b.id ? -1 : 1))) {
 130:     const lista = porNombre.get(e.nombre) ?? [];
 131:     lista.push(e);
 132:     porNombre.set(e.nombre, lista);
 133:   }
 134:   const etiquetas = new Map<string, string>();
 135:   for (const [nombre, lista] of porNombre) {
 136:     if (lista.length === 1) {
 137:       etiquetas.set(lista[0].id, nombre);
 138:     } else {
 139:       lista.forEach((e, i) => etiquetas.set(e.id, `${nombre} ${i + 1}`));
 140:     }
 141:   }
 142:   return etiquetas;
 143: }
 144: 
 145: /**
 146:  * Columna de cada equipo según su papel en el flujo de señal: quien solo
 147:  * emite a la izquierda, quien emite y recibe en medio, quien solo recibe a la
 148:  * derecha. Los equipos sin conexión van a la última columna, que es donde
 149:  * menos estorban sin desaparecer: siguen siendo material de la sala.
 150:  */
 151: export function columnaDeEquipo(
 152:   equipoId: string,
 153:   conexiones: Conexion[],
 154: ): 0 | 1 | 2 | 3 {
 155:   const emite = conexiones.some((c) => c.origen_id === equipoId);
 156:   const recibe = conexiones.some((c) => c.destino_id === equipoId);
 157:   if (emite && recibe) return 1;
 158:   if (emite) return 0;
 159:   if (recibe) return 2;
 160:   return 3;
 161: }
 162: 
 163: function filasDeBloque(
 164:   puertos: Puerto[],
 165:   usados: Set<string>,
 166:   soloConectados: boolean,
 167: ): { izquierda: Puerto[]; derecha: Puerto[] } {
 168:   const visibles = soloConectados ? puertos.filter((p) => usados.has(p.id)) : puertos;
 169:   const ordenados = [...visibles].sort(
 170:     (a, b) => (a.orden ?? 999) - (b.orden ?? 999) || (a.nombre < b.nombre ? -1 : 1),
 171:   );
 172:   return {
 173:     izquierda: ordenados.filter((p) => ladoDePuerto(p.sentido) === 'izquierda'),
 174:     derecha: ordenados.filter((p) => ladoDePuerto(p.sentido) === 'derecha'),
 175:   };
 176: }
 177: 
 178: export function construirDiagrama(entrada: EntradaDiagrama): EscenaDiagrama {
 179:   const m = MEDIDAS_DIAGRAMA;
 180:   const {
 181:     equipos,
 182:     puertosPorArticulo,
 183:     conexiones,
 184:     descripcionArticulo,
 185:     categoriaArticulo,
 186:     soloConectados = false,
 187:   } = entrada;
 188: 
 189:   const identificadores = identificadoresDeCable(conexiones);
 190:   const etiquetas = etiquetasDeEquipos(equipos);
 191:   const puertosUsados = new Set<string>();
 192:   for (const c of conexiones) {
 193:     if (c.puerto_origen_id) puertosUsados.add(c.puerto_origen_id);
 194:     if (c.puerto_destino_id) puertosUsados.add(c.puerto_destino_id);
 195:   }
 196: 
 197:   // --- bloques por columna, en orden estable -------------------------------
 198:   const columnas: EquipoEnSala[][] = [[], [], [], []];
 199:   for (const e of [...equipos].sort((a, b) => (a.id < b.id ? -1 : 1))) {
 200:     columnas[columnaDeEquipo(e.id, conexiones)].push(e);
 201:   }
 202:   // Sin equipos desconectados no se reserva su columna.
 203:   const columnasOcupadas = columnas
 204:     .map((lista, i) => ({ lista, i }))
 205:     .filter((c) => c.lista.length > 0);
 206: 
 207:   const bloques: BloqueDiagrama[] = [];
 208:   const filaPorPuerto = new Map<string, { bloque: BloqueDiagrama; fila: FilaPuertoDiagrama }>();
 209:   const bloquePorEquipo = new Map<string, BloqueDiagrama>();
 210: 
 211:   let x = m.margen;
 212:   let altoTotal = 0;
 213: 
 214:   for (const { lista } of columnasOcupadas) {
 215:     let y = m.margen;
 216:     for (const equipo of lista) {
 217:       const puertos = puertosPorArticulo.get(equipo.articulo_id) ?? [];
 218:       const { izquierda, derecha } = filasDeBloque(puertos, puertosUsados, soloConectados);
 219:       const nFilas = Math.max(izquierda.length, derecha.length, 1);
 220:       const alto = m.alto_cabecera + nFilas * m.alto_fila + m.alto_pie;
 221: 
 222:       const bloque: BloqueDiagrama = {
 223:         equipo_id: equipo.id,
 224:         etiqueta: etiquetas.get(equipo.id) ?? equipo.nombre,
 225:         categoria: categoriaArticulo?.get(equipo.articulo_id) ?? null,
 226:         marca_modelo: descripcionArticulo?.get(equipo.articulo_id) ?? null,
 227:         x,
 228:         y,
 229:         ancho: m.ancho_bloque,
 230:         alto,
 231:         entradas: [],
 232:         salidas: [],
 233:       };
 234: 
 235:       const filar = (p: Puerto, i: number): FilaPuertoDiagrama => ({
 236:         puerto_id: p.id,
 237:         nombre: p.nombre,
 238:         conector: p.conector,
 239:         senal: p.senal,
 240:         total: p.total,
 241:         conectado: puertosUsados.has(p.id),
 242:         y: y + m.alto_cabecera + i * m.alto_fila + m.alto_fila / 2,
 243:       });
 244:       bloque.entradas = izquierda.map(filar);
 245:       bloque.salidas = derecha.map(filar);
 246:       for (const f of [...bloque.entradas, ...bloque.salidas]) {
 247:         filaPorPuerto.set(f.puerto_id, { bloque, fila: f });
 248:       }
 249:       bloquePorEquipo.set(equipo.id, bloque);
 250:       bloques.push(bloque);
 251: 
 252:       y += alto + m.separacion_y;
 253:     }
 254:     altoTotal = Math.max(altoTotal, y - m.separacion_y + m.margen);
 255:     x += m.ancho_bloque + m.separacion_x;
 256:   }
 257: 
 258:   // --- líneas ---------------------------------------------------------------
 259:   const lineas: LineaDiagrama[] = [];
 260:   let omitidas = 0;
 261: 
 262:   // Cada línea discurre por un carril vertical propio del canal entre
 263:   // columnas: dos cables que comparten canal no se superponen.
 264:   let carril = 0;
 265: 
 266:   for (const c of ordenarConexiones(conexiones)) {
 267:     const bOrigen = bloquePorEquipo.get(c.origen_id);
 268:     const bDestino = bloquePorEquipo.get(c.destino_id);
 269:     if (!bOrigen || !bDestino) {
 270:       omitidas += 1;
 271:       continue;
 272:     }
 273: 
 274:     // El cable sale del lado derecho del origen y entra por el izquierdo del
 275:     // destino. Si el puerto se conoce, a la altura de su fila; si no, a media
 276:     // cabecera, que se lee como "del equipo en general".
 277:     const fOrigen = c.puerto_origen_id ? filaPorPuerto.get(c.puerto_origen_id) : undefined;
 278:     const fDestino = c.puerto_destino_id ? filaPorPuerto.get(c.puerto_destino_id) : undefined;
 279: 
 280:     const x1 = bOrigen.x + bOrigen.ancho + m.largo_conector;
 281:     const y1 = fOrigen?.fila.y ?? bOrigen.y + m.alto_cabecera / 2;
 282:     const x2 = bDestino.x - m.largo_conector;
 283:     const y2 = fDestino?.fila.y ?? bDestino.y + m.alto_cabecera / 2;
 284: 
 285:     carril += 1;
 286:     const carrilX =
 287:       Math.min(x1, x2) +
 288:       Math.abs(x2 - x1) / 2 +
 289:       ((carril % 5) - 2) * 12; // cinco carriles repartidos alrededor del centro
 290: 
 291:     const puntos =
 292:       y1 === y2
 293:         ? [
 294:             { x: x1, y: y1 },
 295:             { x: x2, y: y2 },
 296:           ]
 297:         : [
 298:             { x: x1, y: y1 },
 299:             { x: carrilX, y: y1 },
 300:             { x: carrilX, y: y2 },
 301:             { x: x2, y: y2 },
 302:           ];
 303: 
 304:     lineas.push({
 305:       conexion_id: c.id,
 306:       identificador: identificadores.get(c.id) ?? '—',
 307:       senal: c.senal,
 308:       puntos,
 309:       etiqueta_x: carrilX,
 310:       etiqueta_y: Math.min(y1, y2) + Math.abs(y2 - y1) / 2,
 311:     });
 312:   }
 313: 
 314:   const anchoTotal =
 315:     columnasOcupadas.length > 0
 316:       ? m.margen * 2 +
 317:         columnasOcupadas.length * m.ancho_bloque +
 318:         (columnasOcupadas.length - 1) * m.separacion_x
 319:       : m.margen * 2;
 320: 
 321:   return {
 322:     bloques,
 323:     lineas,
 324:     ancho: anchoTotal,
 325:     alto: Math.max(altoTotal, m.margen * 2),
 326:     omitidas,
 327:   };
 328: }
   1: import assert from 'node:assert/strict';
   2: import { describe, it } from 'node:test';
   3: 
   4: import {
   5:   columnaDeEquipo,
   6:   construirDiagrama,
   7:   etiquetasDeEquipos,
   8:   ladoDePuerto,
   9:   MEDIDAS_DIAGRAMA,
  10:   type EntradaDiagrama,
  11: } from './diagrama';
  12: import type { Conexion, EquipoEnSala, Puerto } from './tipos';
  13: 
  14: /**
  15:  * El caso de referencia es la sala de telepresencia: caja de conexiones que
  16:  * emite, códec que recibe y emite, y pantalla que solo recibe. Es el flujo de
  17:  * las 144 salas iguales del inventario.
  18:  */
  19: 
  20: const equipo = (id: string, nombre: string, articulo_id: string): EquipoEnSala => ({
  21:   id,
  22:   sala_id: 'sala-1',
  23:   articulo_id,
  24:   nombre,
  25:   cantidad: 1,
  26:   extremo: 'mesa',
  27:   posicion: { x_m: 0, y_m: 0, z_m: 0 },
  28:   posicion_confirmada: false,
  29:   rotacion_grados: 0,
  30: });
  31: 
  32: const puerto = (
  33:   id: string,
  34:   articulo_id: string,
  35:   nombre: string,
  36:   sentido: Puerto['sentido'],
  37:   senal: Puerto['senal'] = 'hdmi',
  38:   orden: number | null = null,
  39: ): Puerto => ({
  40:   id,
  41:   articulo_id,
  42:   nombre,
  43:   total: 1,
  44:   sentido,
  45:   senal,
  46:   conector: 'HDMI A',
  47:   orden,
  48:   notas: null,
  49:   fuente: 'csv',
  50: });
  51: 
  52: const conexion = (
  53:   id: string,
  54:   origen_id: string,
  55:   destino_id: string,
  56:   extra: Partial<Conexion> = {},
  57: ): Conexion => ({
  58:   id,
  59:   sala_id: 'sala-1',
  60:   origen_id,
  61:   destino_id,
  62:   articulo_cable_id: null,
  63:   senal: 'hdmi',
  64:   ruta: null,
  65:   longitud_manual_m: null,
  66:   notas: null,
  67:   creado_en: `2026-01-0${id.length}`,
  68:   ...extra,
  69: });
  70: 
  71: /** Caja → códec → pantalla, con puertos conocidos en el tramo códec-pantalla. */
  72: function entradaTipo(): EntradaDiagrama {
  73:   const equipos = [
  74:     equipo('e-caja', 'Caja de conexiones', 'a-caja'),
  75:     equipo('e-codec', 'Codec Cisco', 'a-codec'),
  76:     equipo('e-tv', 'Pantalla', 'a-tv'),
  77:   ];
  78:   const puertos = new Map<string, Puerto[]>([
  79:     ['a-caja', [puerto('p-caja-out', 'a-caja', 'HDMI OUT', 'salida')]],
  80:     [
  81:       'a-codec',
  82:       [
  83:         puerto('p-codec-in', 'a-codec', 'HDMI IN 1', 'entrada', 'hdmi', 1),
  84:         puerto('p-codec-out', 'a-codec', 'HDMI OUT 1', 'salida', 'hdmi', 2),
  85:         puerto('p-codec-lan', 'a-codec', 'LAN PoE', 'bidireccional', 'red', 3),
  86:       ],
  87:     ],
  88:     ['a-tv', [puerto('p-tv-in', 'a-tv', 'HDMI IP1', 'entrada')]],
  89:   ]);
  90:   const conexiones = [
  91:     conexion('c1', 'e-caja', 'e-codec', { puerto_destino_id: 'p-codec-in' }),
  92:     conexion('c22', 'e-codec', 'e-tv', {
  93:       puerto_origen_id: 'p-codec-out',
  94:       puerto_destino_id: 'p-tv-in',
  95:     }),
  96:   ];
  97:   return { equipos, puertosPorArticulo: puertos, conexiones };
  98: }
