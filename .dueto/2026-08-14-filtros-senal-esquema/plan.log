 189:   const identificadores = identificadoresDeCable(conexiones);
 190:   const etiquetas = etiquetasDeEquipos(equipos);
 191:   const puertosUsados = new Set<string>();
 192:   for (const c of conexiones) {
 193:     if (c.puerto_origen_id) puertosUsados.add(c.puerto_origen_id);
 194:     if (c.puerto_destino_id) puertosUsados.add(c.puerto_destino_id);
 195:   }
 196: 
 197:   // --- bloques por columna, en orden estable -------------------------------
 198:   const columnas: EquipoEnSala[][] = [[], [], [], []];
 199:   for (const e of [...equipos].sort((a, b) => (a.id < b.id ? -1 : 1))) {
 200:     columnas[columnaDeEquipo(e.id, conexiones)].push(e);
 201:   }
 202:   // Sin equipos desconectados no se reserva su columna.
 203:   const columnasOcupadas = columnas
 204:     .map((lista, i) => ({ lista, i }))
 205:     .filter((c) => c.lista.length > 0);
 206: 
 207:   const bloques: BloqueDiagrama[] = [];
 208:   const filaPorPuerto = new Map<string, { bloque: BloqueDiagrama; fila: FilaPuertoDiagrama }>();
 209:   const bloquePorEquipo = new Map<string, BloqueDiagrama>();
 210: 
 211:   let x = m.margen;
 212:   let altoTotal = 0;
 213: 
 214:   for (const { lista } of columnasOcupadas) {
 215:     let y = m.margen;
 216:     for (const equipo of lista) {
 217:       const puertos = puertosPorArticulo.get(equipo.articulo_id) ?? [];
 218:       const { izquierda, derecha } = filasDeBloque(puertos, puertosUsados, soloConectados);
 219:       const nFilas = Math.max(izquierda.length, derecha.length, 1);
 220:       const alto = m.alto_cabecera + nFilas * m.alto_fila + m.alto_pie;
 221: 
 222:       const bloque: BloqueDiagrama = {
 223:         equipo_id: equipo.id,
 224:         etiqueta: etiquetas.get(equipo.id) ?? equipo.nombre,
 225:         categoria: categoriaArticulo?.get(equipo.articulo_id) ?? null,
 226:         marca_modelo: descripcionArticulo?.get(equipo.articulo_id) ?? null,
 227:         x,
 228:         y,
 229:         ancho: m.ancho_bloque,
 230:         alto,
 231:         entradas: [],
 232:         salidas: [],
 233:       };
 234: 
 235:       const filar = (p: Puerto, i: number): FilaPuertoDiagrama => ({
 236:         puerto_id: p.id,
 237:         nombre: p.nombre,
 238:         conector: p.conector,
 239:         senal: p.senal,
 240:         total: p.total,
 241:         conectado: puertosUsados.has(p.id),
 242:         y: y + m.alto_cabecera + i * m.alto_fila + m.alto_fila / 2,
 243:       });
 244:       bloque.entradas = izquierda.map(filar);
 245:       bloque.salidas = derecha.map(filar);
 246:       for (const f of [...bloque.entradas, ...bloque.salidas]) {
