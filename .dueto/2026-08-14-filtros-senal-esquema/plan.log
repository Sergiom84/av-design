 142: describe('construirDiagrama', () => {
 143:   it('coloca cada bloque en su columna, de izquierda a derecha', () => {
 144:     const escena = construirDiagrama(entradaTipo());
 145:     const porId = new Map(escena.bloques.map((b) => [b.equipo_id, b]));
