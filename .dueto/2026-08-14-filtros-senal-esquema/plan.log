 200:     assert.equal(primero.y, salida.y, 'sale a la altura de la fila del puerto de origen');
 201:     assert.equal(ultimo.y, entrada.y, 'entra a la altura de la fila del puerto de destino');
 202:     assert.ok(primero.x > codec.x + codec.ancho, 'sale por el lado derecho del bloque');
 203:     assert.ok(ultimo.x < tv.x, 'entra por el lado izquierdo del bloque');
 204:   });
 205: 
 206:   it('la ruta es ortogonal: solo tramos horizontales o verticales', () => {
 207:     const escena = construirDiagrama(entradaTipo());
