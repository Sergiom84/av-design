 102:     assert.equal(ladoDePuerto('entrada'), 'izquierda');
 103:     assert.equal(ladoDePuerto('control'), 'izquierda');
 104:     assert.equal(ladoDePuerto('salida'), 'derecha');
 105:     assert.equal(ladoDePuerto('bidireccional'), 'derecha');
