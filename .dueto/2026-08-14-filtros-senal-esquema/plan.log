 168:     const codec = escena.bloques.find((b) => b.equipo_id === 'e-codec')!;
 169:     const tv = escena.bloques.find((b) => b.equipo_id === 'e-tv')!;
 170:     const m = MEDIDAS_DIAGRAMA;
 171:     assert.equal(codec.alto, m.alto_cabecera + 2 * m.alto_fila + m.alto_pie);
 172:     assert.equal(tv.alto, m.alto_cabecera + 1 * m.alto_fila + m.alto_pie);
 173:   });
 174: 
 175:   it('con soloConectados desaparecen los puertos sin cable, no los bloques', () => {
