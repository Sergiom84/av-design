   4:  * La medida de verdad se toma en el navegador: sin motor de disposición no hay
   5:  * píxeles que medir, y esto no los mide. Lo que sí caza es la regresión que
   6:  * hubo: la regla existía y estaba escrita para `max-width: 640px`, así que a
   7:  * 768 —una tableta, con el dedo— los campos medían 34 px y el informe daba el
   8:  * objetivo por cumplido porque la regla aparecía en el fichero.
   9:  *
  10:  * Aquí se comprueba dónde entra la regla y a qué alcanza. Que de verdad mida
  11:  * 44 px se comprueba a 768, 390 y 320 en el navegador.
  12:  */
  13: 
  14: import assert from 'node:assert/strict';
  15: import { readFileSync } from 'node:fs';
  16: import { describe, it } from 'node:test';
  17: 
  18: const CSS = readFileSync(new URL('../app/globals.css', import.meta.url), 'utf8');
  19: 
  20: /** El bloque `@media` del mínimo táctil, con sus llaves equilibradas. */
  21: function bloqueTactil(): string {
  22:   const inicio = CSS.indexOf('@media (max-width: 768px)');
  23:   assert.notEqual(
  24:     inicio,
  25:     -1,
  26:     'el mínimo táctil tiene que entrar en tableta (768 px), no solo por debajo de 640',
  27:   );
  28:   const i = CSS.indexOf('{', inicio);
  29:   let nivel = 0;
  30:   for (let j = i; j < CSS.length; j += 1) {
  31:     if (CSS[j] === '{') nivel += 1;
  32:     else if (CSS[j] === '}') {
  33:       nivel -= 1;
  34:       if (nivel === 0) return CSS.slice(i, j + 1);
  35:     }
  36:   }
  37:   throw new Error('bloque @media sin cerrar');
  38: }
  39: 
  40: describe('el objetivo táctil mínimo', () => {
  41:   const bloque = bloqueTactil();
  42: 
  43:   it('no se queda por debajo de 640 px: a 768 se usa con el dedo', () => {
  44:     assert.equal(
  45:       CSS.includes('@media (max-width: 640px)'),
  46:       false,
  47:       'la regla antigua dejaba fuera la tableta',
  48:     );
  49:   });
  50: 
  51:   it('alcanza a los botones, tengan o no la clase del sistema', () => {
  52:     assert.ok(bloque.includes('.boton'), 'los botones del sistema');
  53:     assert.ok(/(^|[\s,])button([\s,])/.test(bloque), 'y cualquier <button>');
  54:     assert.ok(bloque.includes('[role="button"]'), 'y lo que se comporta como botón');
  55:   });
  56: 
  57:   it('alcanza a campos, selectores y áreas de texto', () => {
  58:     assert.ok(bloque.includes('input:not([type="checkbox"]):not([type="radio"])'));
  59:     assert.ok(/(^|[\s,])select([\s,])/.test(bloque));
  60:     assert.ok(/(^|[\s,])textarea([\s,])/.test(bloque));
  61:   });
  62: 
  63:   it('pide 44 px de alto y de ancho a lo accionable', () => {
  64:     const alturas = [...bloque.matchAll(/min-height:\s*(\d+)px/g)].map((m) => Number(m[1]));
  65:     const anchuras = [...bloque.matchAll(/min-width:\s*(\d+)px/g)].map((m) => Number(m[1]));
  66:     assert.ok(alturas.length >= 3, 'varias reglas de alto mínimo');
  67:     assert.ok(
  68:       alturas.every((v) => v >= 44),
  69:       `ningún mínimo por debajo de 44: ${alturas.join(', ')}`,
  70:     );
  71:     assert.ok(anchuras.length >= 1 && anchuras.every((v) => v >= 44));
  72:   });
  73: });

