  49:     await readFile(new URL('../output/e2e/diagrama/resultado.json', import.meta.url), 'utf8'),
  50:   );
  51:   const estadisticas = resultado.stats ?? {};
  52:   if (!resultadoE2eAprobado(codigo, estadisticas)) {
  53:     console.error(
  54:       `Gate E2E no aprobado: codigo=${codigo}, ` +
  55:         `aprobadas=${estadisticas.expected ?? 'desconocido'}, ` +
  56:         `omitidas=${estadisticas.skipped ?? 'desconocido'}, ` +
  57:         `inesperadas=${estadisticas.unexpected ?? 'desconocido'}, ` +
  58:         `inestables=${estadisticas.flaky ?? 'desconocido'}.`,
  59:     );
  60:     process.exitCode = codigo || 1;
  61:   }
  62: }
  63: 
  64: try {
  65:   await ejecutar();
  66: } finally {
  67:   await admin.unsafe(
  68:     `select pg_terminate_backend(pid) from pg_stat_activity where datname = '${nombre}' and pid <> pg_backend_pid()`,
  69:   );
  70:   await admin.unsafe(`drop database if exists "${nombre}"`);
  71:   await admin.end();
  72:   await rm(new URL('../.next-e2e-diagrama', import.meta.url), { recursive: true, force: true });
  73: }

