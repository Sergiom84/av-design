 281:     const y1 = fOrigen?.fila.y ?? bOrigen.y + m.alto_cabecera / 2;
 282:     const x2 = bDestino.x - m.largo_conector;
 283:     const y2 = fDestino?.fila.y ?? bDestino.y + m.alto_cabecera / 2;
