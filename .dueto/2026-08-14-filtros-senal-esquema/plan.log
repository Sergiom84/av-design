 190:     const l2 = escena.lineas.find((l) => l.conexion_id === 'c22')!;
 191:     assert.equal(l1.identificador, 'HD-1000');
 192:     assert.equal(l2.identificador, 'HD-1001');
 193: 
 194:     const codec = escena.bloques.find((b) => b.equipo_id === 'e-codec')!;
 195:     const tv = escena.bloques.find((b) => b.equipo_id === 'e-tv')!;
 196:     const salida = codec.salidas.find((f) => f.nombre === 'HDMI OUT 1')!;
 197:     const entrada = tv.entradas.find((f) => f.nombre === 'HDMI IP1' || f.nombre === 'HDMI IN 1')!;
 198:     const primero = l2.puntos[0];
