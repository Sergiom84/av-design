 390: -- plano no puede borrar el equipo que colgaba de ella.
 391: alter table sala_equipos add column if not exists toma_red_id uuid
 392:   references tomas_red on delete set null;
 393: 
 394: create index if not exists sala_equipos_toma_idx on sala_equipos (toma_red_id);
 395: 
 396: -- ---------------------------------------------------------------------
 397: -- Conexiones puerto a puerto
 398: --
 399: -- Esto es lo que convierte "la pantalla va al Room Bar" en "la salida
 400: -- HDMI OUT 1 del Room Bar va a la entrada HDMI IN 2 de la pantalla", que
 401: -- es lo que hace falta para etiquetar en obra y para la tabla de cables.
 402: --
 403: -- Opcionales porque ya hay conexiones dadas de alta sin puerto y no se
 404: -- pueden romper; `set null` porque corregir el catálogo de puertos de un
 405: -- artículo no puede borrar la tirada de una sala.
 406: -- ---------------------------------------------------------------------
 407: alter table conexiones add column if not exists puerto_origen_id uuid
 408:   references puertos on delete set null;
 409: alter table conexiones add column if not exists puerto_destino_id uuid
 410:   references puertos on delete set null;
 411: 
 412: -- El identificador de cable (HD-1000, RED-1001) tiene que ser estable entre
 413: -- recargas: una tirada ya etiquetada en obra no puede cambiar de número
 414: -- porque se dé de alta otra. Se numera por orden de creación, así que hace
