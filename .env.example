# Copiar a .env.local

# Postgres local en Docker (npm run db:up).
# El puerto es el 5433 para no chocar con otro Postgres que ya tengas en el 5432.
DATABASE_URL=postgres://av_design:av_design_local@localhost:5433/av_design

# En produccion esta misma variable apunta a Neon. Para cambiar de proveedor
# basta con poner aqui otra cadena de conexion a Postgres y aplicar
# db/schema.sql y db/seed.sql.
# En Render se configura como variable de entorno del servicio, nunca en el repo.

# ---------------------------------------------------------------------
# Puerta de entrada
#
# Una sola clave para todo el departamento. La clave NO se guarda en
# ningun sitio: se guarda su huella SHA-256, y es lo que se compara.
#
# Para calcular la huella de una clave, desde la raiz del repositorio:
#
#   node -e "crypto.subtle.digest('SHA-256',new TextEncoder().encode(process.argv[1])).then(b=>console.log(Buffer.from(b).toString('hex')))" "LA-CLAVE"
#
# El secreto firma la cookie de sesion. Cualquier cadena larga y
# aleatoria vale; cambiarla echa a todo el mundo, que es justo lo que se
# quiere si se sospecha que alguien se ha colado.
#
#   node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
#
# Si faltan las dos en desarrollo, la aplicacion no pide clave. En
# produccion, si faltan, NO se deja pasar a nadie: un despliegue al que
# se le olvido la variable es justo el caso en el que el inventario
# acaba abierto a internet.
# ---------------------------------------------------------------------
CLAVE_ACCESO_HASH=
SESION_SECRETO=
