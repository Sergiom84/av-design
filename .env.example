# Copiar a .env.local

# Postgres local en Docker (npm run db:up).
# El puerto es el 5433 para no chocar con otro Postgres que ya tengas en el 5432.
DATABASE_URL=postgres://av_design:av_design_local@localhost:5433/av_design

# En produccion esta misma variable apunta a Neon. Para cambiar de proveedor
# basta con poner aqui otra cadena de conexion a Postgres y aplicar
# db/schema.sql y db/seed.sql.
# En Render se configura como variable de entorno del servicio, nunca en el repo.
