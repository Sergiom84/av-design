# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-e2e-diagrama/
/.next-visual-qa/
/.next-e1-documentos/
/.next-e2-importacion/
/.next-e2-reanudacion/
/.next-e2-build/
/.next-e3-revisiones/
/.next-e3-build/
/.next-rea-integracion/
/.next-rea-build/
/.playwright-cli/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# La plantilla sí se publica: el README manda copiarla, y sin ella un clon
# limpio no arranca. No lleva ningún valor real.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# volcado de la web de referencia (XTEN-AV): material de consulta local, no se publica
/Inicio/

# Inventarios reales: contienen IPs, MAC y numeros de serie de la red corporativa.
# Se quedan en local; lo que se publica son los CSV derivados, ya sin esos datos.
/docs/*.xlsx

# ficheros de trabajo: volcados, informes intermedios, copias de la base
/.tmp/
/.next-rea01-integracion/
/.next-rea02-integracion/
/.next-rea03-integracion/
/.next-rea04-integracion/
/.next-rea06-integracion/

# artefactos del E2E multiagente (docs/09-plan-visual-y-e2e.md, apartado 7.6): capturas,
# consola y trazas de cada corrida, fuera del commit a propósito
/output/

# Resguardo de scripts/mutaciones-lote1.mjs: solo existe mientras corre.
scripts/.mutacion-en-curso/
*.ajeno

.next-rea05-integracion/
.next-rea05-costes-integracion/
.next-rea07-integracion/

# Tipos Next generados para gates locales; no son fuentes publicables.
/.next-rea-global-types/
