import { test,expect,type BrowserContext } from '@playwright/test';
import { resolve } from 'node:path';
import { mkdir,writeFile } from 'node:fs/promises';
import { conectarRevisiones,URL_REA_PRUEBA,type SqlRevisionesPrueba,fotografiarRevisiones } from '../scripts/rea02-fixture.mjs';
import { COOKIE_SESION,firmarSesion } from '../src/lib/sesion';
const id=(n:number)=>`d2000000-0000-4000-8000-${String(n).padStart(12,'0')}`;
const origen='http://localhost:3112',salida=resolve('output/rea-integracion/rea02');let sql:SqlRevisionesPrueba;let antes:Awaited<ReturnType<typeof fotografiarRevisiones>>;
async function entrar(c:BrowserContext,n=1){await c.clearCookies();await c.addCookies([{name:COOKIE_SESION,value:await firmarSesion('rea02-local-prueba-integracion-secreto-2026',Date.now()+3600000,id(n)),domain:'localhost',path:'/',httpOnly:true,sameSite:'Lax'}]);}
const headers={origin:origen};
test.describe.serial('REA02 · escritorio completo antes de móvil',()=>{
 test.beforeAll(async()=>{if(process.env.REA_DATABASE_URL!==URL_REA_PRUEBA)throw new Error('URL REA02 explícita exacta obligatoria.');sql=await conectarRevisiones(process.env.REA_DATABASE_URL);await mkdir(salida,{recursive:true});
  expect((await sql`select id from usuarios where id=${id(1)}`).length).toBe(1);
  await sql`delete from preferencias_usuario where usuario_id in(${id(1)},${id(2)})`;await sql`delete from usuario_permisos where usuario_id=${id(1)}`;antes=await fotografiarRevisiones(sql);
 });
 test.afterAll(async()=>{if(sql){const despues=await fotografiarRevisiones(sql);const ignorar=new Set(['preferencias_usuario','usuario_permisos']);expect(despues.tablas.filter(t=>!ignorar.has(t.tabla))).toEqual(antes.tablas.filter(t=>!ignorar.has(t.tabla)));await writeFile(resolve(salida,'e2e-hechos-despues.json'),JSON.stringify(despues,null,2));await sql.end();}});
 test('escritorio: guardar marcas, filtros literales, reabrir, dos usuarios y catálogo completo',async({page,context})=>{
  await entrar(context);const errores:string[]=[];page.on('pageerror',e=>errores.push(e.message));
  await page.goto('/cuenta');await expect(page.getByLabel('Marcas preferidas',{exact:true})).toBeVisible();
  await page.getByLabel('Marcas preferidas',{exact:true}).fill('REA02 Marca\nREA02 Variante\nREA02 Retirada');await page.getByLabel('Buscar en referencias preferidas').fill('Objetivo');await page.getByLabel('Tipo preferido').selectOption('equipo');
  await page.getByRole('button',{name:'Guardar preferencias',exact:true}).click();await expect(page.getByRole('status').filter({hasText:'Preferencias guardadas.'})).toBeVisible();await page.reload();await expect(page.getByLabel('Marcas preferidas',{exact:true})).toHaveValue('REA02 Marca\nREA02 Variante\nREA02 Retirada');
  await page.goto('/catalogo');await expect(page.getByRole('link',{name:'REA02 Marca QB65R',exact:true})).toBeVisible();await expect(page.getByText('Sin referencias activas para estas marcas: REA02 Retirada.')).toBeVisible();await expect(page.getByRole('link',{name:'REA02 Marca QB65R-B',exact:true})).toHaveCount(0);await page.screenshot({path:resolve(salida,'escritorio-catalogo.png'),fullPage:true});
  await entrar(context,2);await page.goto('/cuenta');await expect(page.getByLabel('Marcas preferidas',{exact:true})).toHaveValue('');await page.getByLabel('Marcas preferidas',{exact:true}).fill('REA02 Variante');await page.getByRole('button',{name:'Guardar preferencias',exact:true}).click();await expect(page.getByRole('status').filter({hasText:'Preferencias guardadas.'})).toBeVisible();
  await entrar(context);await page.goto('/cuenta');await expect(page.getByLabel('Marcas preferidas',{exact:true})).toHaveValue('REA02 Marca\nREA02 Variante\nREA02 Retirada');await page.getByRole('button',{name:'Restablecer catálogo',exact:true}).click();await expect(page.getByLabel('Marcas preferidas',{exact:true})).toHaveValue('');await page.goto('/catalogo');await expect(page.getByText(/sin marcas elegidas; catálogo completo con tus filtros/)).toBeVisible();expect(errores).toEqual([]);
 });
 test('escritorio: orden, ocultar todas, restablecer por teclado y retirada ACL sin cookie nueva',async({page,context})=>{
  await entrar(context);await page.goto('/');await expect(page.locator('[data-tarjeta]')).toHaveCount(9);
  await page.getByRole('button',{name:'Bajar Equipos en catálogo',exact:true}).focus();await page.keyboard.press('Enter');await page.getByRole('button',{name:'Guardar preferencias',exact:true}).click();await expect(page.getByRole('status').filter({hasText:'Preferencias guardadas.'})).toBeVisible();await expect(page.locator('[data-tarjeta]').first()).toHaveAttribute('data-tarjeta','cables');
  for(const checkbox of await page.getByRole('checkbox').all())await checkbox.uncheck();await page.getByRole('button',{name:'Guardar preferencias',exact:true}).click();await expect(page.locator('[data-tarjeta]')).toHaveCount(0);await expect(page.getByRole('button',{name:'Restablecer Panel',exact:true})).toBeVisible();await page.screenshot({path:resolve(salida,'escritorio-todo-oculto.png'),fullPage:true});
  await page.getByRole('button',{name:'Restablecer Panel',exact:true}).focus();await page.keyboard.press('Enter');await expect(page.locator('[data-tarjeta]')).toHaveCount(9);await page.reload();await expect(page.locator('[data-tarjeta]').first()).toHaveAttribute('data-tarjeta','equipos');
  for(const seccion of ['catalogo','plantillas','compras','carga'])await sql`insert into usuario_permisos(usuario_id,seccion,acceso)values(${id(1)},${seccion},'oculto')on conflict(usuario_id,seccion)do update set acceso='oculto'`;
  await page.reload();await expect(page.locator('[data-tarjeta]')).toHaveCount(3);
  for(const nombre of ['Equipos en catálogo','Referencias de cable','Consumibles','Plantillas de sala','Pedidos en curso','Cargas abiertas'])expect(await page.content()).not.toContain(nombre);
  const r=await context.request.get('/api/preferencias?grupo=panel');expect(r.status()).toBe(200);expect(JSON.stringify(await r.json())).not.toMatch(/pedidos|cargas|equipos|plantillas/);expect((await context.request.get('/api/catalogo-preferido')).status()).toBe(403);await page.screenshot({path:resolve(salida,'escritorio-permisos-retirados.png'),fullPage:true});
  await sql`delete from usuario_permisos where usuario_id=${id(1)}`;
 });
 test('escritorio: conflicto entre pestañas conserva edición, errores de red y respuesta tardía',async({page,context})=>{
  await entrar(context);await page.goto('/cuenta');const otra=await context.newPage();await otra.goto('/cuenta');await expect(otra.getByLabel('Marcas preferidas',{exact:true})).toBeVisible();
  await page.getByLabel('Marcas preferidas',{exact:true}).fill('REA02 Marca');await page.getByRole('button',{name:'Guardar preferencias',exact:true}).click();await expect(page.getByRole('status').filter({hasText:'Preferencias guardadas.'})).toBeVisible();
  await otra.getByLabel('Marcas preferidas',{exact:true}).fill('REA02 Variante');await otra.getByRole('button',{name:'Guardar preferencias',exact:true}).click();await expect(otra.getByRole('status').filter({hasText:/otra pestaña/})).toBeVisible();await expect(otra.getByLabel('Marcas preferidas',{exact:true})).toHaveValue('REA02 Variante');
  await otra.getByRole('button',{name:'Recargar y comparar',exact:true}).click();await expect(otra.getByText(/Tu edición sigue en el formulario/)).toBeVisible();await expect(otra.getByLabel('Marcas preferidas',{exact:true})).toHaveValue('REA02 Variante');await otra.getByRole('button',{name:'Usar versión del servidor',exact:true}).click();await expect(otra.getByLabel('Marcas preferidas',{exact:true})).toHaveValue('REA02 Marca');
  await otra.getByLabel('Marcas preferidas',{exact:true}).fill('REA02 Variante');await otra.route('**/api/preferencias',route=>route.abort('failed'));await otra.getByRole('button',{name:'Guardar preferencias',exact:true}).click();await expect(otra.getByRole('status')).toContainText(/fetch|red|Failed/i);await expect(otra.getByLabel('Marcas preferidas',{exact:true})).toHaveValue('REA02 Variante');await otra.unroute('**/api/preferencias');
  let liberar:()=>void=()=>{};const retenida=new Promise<void>(r=>liberar=r);let recibida:()=>void=()=>{};const inicio=new Promise<void>(r=>recibida=r);
  await otra.route('**/api/preferencias',async route=>{recibida();await retenida;await route.continue();});await otra.getByRole('button',{name:'Guardar preferencias',exact:true}).click();await inicio;await expect(otra.getByLabel('Marcas preferidas',{exact:true})).toBeDisabled();await expect(otra.getByLabel('Marcas preferidas',{exact:true})).toHaveValue('REA02 Variante');liberar();await expect(otra.getByRole('status').filter({hasText:'Preferencias guardadas.'})).toBeVisible();await otra.screenshot({path:resolve(salida,'escritorio-recuperacion.png'),fullPage:true});await otra.close();
 });
 test('escritorio: API límites, identidad, origen, provisional/inactivo y ausencia de sesión',async({context,page})=>{
  await entrar(context);const p=await(await context.request.get('/api/preferencias?grupo=catalogo')).json();
  for(const datos of [{grupo:'catalogo',version:p.version,valor:{marcas:['<script>']}},{grupo:'catalogo',version:p.version,valor:{marcas:[]},usuario_id:id(2)},{grupo:'inventado',version:0,valor:{}}])expect((await context.request.put('/api/preferencias',{data:datos,headers})).status()).toBe(400);
  expect((await context.request.put('/api/preferencias',{data:{grupo:'catalogo',version:p.version,valor:{marcas:[]}},headers:{origin:'https://ajeno.invalid'}})).status()).toBe(403);
  expect((await context.request.put('/api/preferencias',{data:' '.repeat(8193),headers:{...headers,'content-type':'application/json'}})).status()).toBe(413);
  await entrar(context,3);expect((await context.request.get('/api/preferencias?grupo=catalogo')).status()).toBe(403);await page.goto('/cuenta');await expect(page.getByLabel('Marcas preferidas',{exact:true})).toHaveCount(0);
  await entrar(context,4);expect((await context.request.get('/api/preferencias?grupo=panel')).status()).toBe(401);await context.clearCookies();expect((await context.request.get('/api/preferencias?grupo=panel',{maxRedirects:0})).status()).toBe(401);
 });
 test('móvil final: editar filtros, consultar y personalizar sin desbordamiento',async({page,context})=>{
  await entrar(context);await page.setViewportSize({width:390,height:844});await page.goto('/cuenta');await expect(page.getByLabel('Marcas preferidas',{exact:true})).toBeVisible();await page.getByLabel('Marcas preferidas',{exact:true}).fill('REA02 Marca');await page.getByLabel('Buscar en referencias preferidas').fill('QB65R-B');await page.getByLabel('Tipo preferido').selectOption('cable');await page.getByRole('button',{name:'Guardar preferencias',exact:true}).click();await expect(page.getByRole('status').filter({hasText:'Preferencias guardadas.'})).toBeVisible();await page.goto('/catalogo');await expect(page.getByRole('link',{name:'REA02 Marca QB65R-B',exact:true})).toBeVisible();expect(await page.evaluate(()=>document.documentElement.scrollWidth<=innerWidth+2)).toBe(true);await page.screenshot({path:resolve(salida,'movil-catalogo.png'),fullPage:true});await page.goto('/');await expect(page.locator('[data-tarjeta]')).toHaveCount(9);await page.getByRole('button',{name:'Bajar Equipos en catálogo',exact:true}).click();await page.getByRole('button',{name:'Guardar preferencias',exact:true}).click();await expect(page.getByRole('status').filter({hasText:'Preferencias guardadas.'})).toBeVisible();await expect(page.locator('[data-tarjeta]').first()).toHaveAttribute('data-tarjeta','cables');expect(await page.evaluate(()=>document.documentElement.scrollWidth<=innerWidth+2)).toBe(true);await page.screenshot({path:resolve(salida,'movil-panel.png'),fullPage:true});
 });
});
