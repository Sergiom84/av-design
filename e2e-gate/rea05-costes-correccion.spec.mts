import {COOKIE_SESION,firmarSesion} from '../src/lib/sesion';
const dir=resolve('output/rea-integracion/rea05/costes-correccion',process.env.REA05_COSTES_EVIDENCIA??'chrome-1');
let c:SqlRevisionesPrueba,f:Awaited<ReturnType<typeof crearDatosCostes>>,p:typeof f&{corteParcial:string;corteExcluido:string;realPagina2:string;previstoPagina2:string;legacyCorte:string;legacyAdmin:string},foto:Awaited<ReturnType<typeof fotografiarRevisiones>>,corteNuevo='';
const headers={Origin:'http://localhost:3117'},secreto='rea05-costes-local-prueba-integracion-2026';
async function entrar(context:BrowserContext,id:string){await context.clearCookies();await context.addCookies([{name:COOKIE_SESION,value:await firmarSesion(secreto,Date.now()+3600000,id),domain:'localhost',path:'/',httpOnly:true,sameSite:'Lax'}]);}
test.describe.serial('Única corrección05: cuatro P2 escritorio y móvil',()=>{
 test.beforeAll(async()=>{expect(process.env.REA05_COSTES_DATABASE_URL).toBe(URL_REA_PRUEBA);c=await conectarRevisiones(URL_REA_PRUEBA);f=await crearDatosCostes(c);await mkdir(dir,{recursive:true});const puntero=JSON.parse(await readFile('output/rea-integracion/rea05/costes-correccion/sql-actual.json','utf8'));p=JSON.parse(await readFile(resolve(puntero.dir,'fixture.json'),'utf8'));foto=await fotografiarRevisiones(c);await writeFile(resolve(dir,'antes.json'),JSON.stringify(foto,null,2));await writeFile(resolve(dir,'fixture.json'),JSON.stringify(f,null,2));});
 test.afterAll(async()=>{if(c){const despues=await fotografiarRevisiones(c);await writeFile(resolve(dir,'despues.json'),JSON.stringify(despues,null,2));for(const t of foto.tablas.filter(t=>!t.tabla.startsWith('coste_')))expect(despues.tablas.find(x=>x.tabla===t.tabla)?.sha256,t.tabla).toBe(t.sha256);await c.end();}});
 test('P2-03/04 escritorio:201 real retrasado conserva nueva edición, reparto7/10 propone3, reintento idempotente y errores',async({page,context})=>{
  await entrar(context,f.admin);await page.goto(`/proyectos/${f.proyecto}/costes`);await page.getByRole('button',{name:'Buscar movimientos',exact:true}).click();const fila=page.getByRole('row').filter({hasText:f.salida});await fila.getByRole('button',{name:'Asociar salida',exact:true}).click();await page.getByLabel('Cantidad imputada (ud)',{exact:true}).fill('7');await page.getByLabel('Calidad material',{exact:true}).selectOption('documentado');await page.getByLabel('Precio unitario histórico',{exact:true}).fill('0.10');await page.getByLabel('Moneda material',{exact:true}).selectOption('EUR');await page.getByLabel('Documento histórico de adquisición',{exact:true}).fill('PRUEBA-CORRECCION05 documento');await page.getByLabel('Fecha de adquisición confirmada',{exact:true}).fill('2026-10-13');await page.getByLabel('Motivo de apunte',{exact:true}).fill('PRUEBA-CORRECCION05 confirmar siete');await page.getByRole('button',{name:'Preparar asociación material',exact:true}).click();await expect(page.getByText('0.70 EUR',{exact:false}).first()).toBeVisible();
  let liberar!:()=>void,recibida!:()=>void,body:unknown,result:{apuntes:unknown}={apuntes:undefined};const espera=new Promise<void>(r=>liberar=r),preparada=new Promise<void>(r=>recibida=r);
  await page.route('**/api/costes/material/confirmar',async ruta=>{body=ruta.request().postDataJSON();const r=await ruta.fetch();expect(r.status()).toBe(201);result=await r.json();recibida();await espera;await ruta.fulfill({response:r});});
  await page.getByRole('button',{name:'Confirmar apunte material',exact:true}).click();await preparada;await page.getByLabel('Motivo de apunte',{exact:true}).fill('PRUEBA-CORRECCION05 EDICION POSTERIOR CONSERVAR');await page.getByLabel('Cantidad imputada (ud)',{exact:true}).fill('3');await page.screenshot({path:resolve(dir,'01a-201-retenido.png'),fullPage:true});liberar();await expect(page.getByText('Apunte material guardado. Los hechos físicos permanecen en su fuente.',{exact:true})).toBeVisible();await expect(page.getByLabel('Motivo de apunte',{exact:true})).toHaveValue('PRUEBA-CORRECCION05 EDICION POSTERIOR CONSERVAR');await expect(page.getByLabel('Cantidad imputada (ud)',{exact:true})).toHaveValue('3');await expect(fila).toContainText('10.00 ud físico');await expect(fila).toContainText('7.00 ud repartido · 3.00 ud pendiente');await page.unroute('**/api/costes/material/confirmar');const retry=await context.request.post('/api/costes/material/confirmar',{headers,data:body});expect(retry.status()).toBe(201);expect((await retry.json()).apuntes).toEqual(result.apuntes);await writeFile(resolve(dir,'retry-confirmacion.json'),JSON.stringify({body,result,retry:await retry.json()},null,2));
  await fila.getByRole('button',{name:'Asociar salida',exact:true}).click();await expect(page.getByLabel('Cantidad imputada (ud)',{exact:true})).toHaveValue('3.00');await page.getByLabel('Motivo de apunte',{exact:true}).fill('PRUEBA-CORRECCION05 nuevo residual');await page.getByLabel('Precio unitario histórico',{exact:true}).fill('1e3');await page.getByRole('button',{name:'Preparar asociación material',exact:true}).click();await expect(page.getByRole('alert').filter({hasText:'Comprueba los campos'})).toBeVisible();await expect(page.getByLabel('Motivo de apunte',{exact:true})).toHaveValue('PRUEBA-CORRECCION05 nuevo residual');await page.getByLabel('Precio unitario histórico',{exact:true}).fill('');await page.getByLabel('Cantidad imputada (ud)',{exact:true}).fill('4');await page.getByRole('button',{name:'Preparar asociación material',exact:true}).click();await expect(page.getByRole('alert').filter({hasText:'supera el movimiento físico'})).toBeVisible();await expect(page.getByLabel('Cantidad imputada (ud)',{exact:true})).toHaveValue('4');await page.getByLabel('Cantidad imputada (ud)',{exact:true}).fill('3.00');await page.screenshot({path:resolve(dir,'01b-borrador-residual-errores.png'),fullPage:true});
 });
 test('P2-01/04 escritorio: guardar/reabrir exclusiones explícitas y residual durable, revisión restaura motivos',async({page,context})=>{
  await entrar(context,f.admin);await page.goto(`/proyectos/${f.proyecto}/costes`);await page.getByLabel('Laboral',{exact:true}).uncheck();await page.getByLabel('Motivo del corte',{exact:true}).fill('PRUEBA-CORRECCION05 exclusiones UI');await page.getByText('Excluir candidatos físicos del alcance con motivo',{exact:true}).click();const excluidos=[f.sobrante,f.roto,f.baja,f.devolucionExceso].map(id=>id+' PRUEBA-CORRECCION05 fuera alcance '+id).join('\n');await page.getByLabel('Exclusiones: UUID de movimiento y motivo, una por línea',{exact:true}).fill(excluidos);await page.getByRole('button',{name:'Preparar corte',exact:true}).click();await expect(page.getByText('0.70 EUR',{exact:true}).first()).toBeVisible();await expect(page.getByText(/Conciliación material: 8 movimientos con residual.*4 pendientes.*4 excluidos/)).toBeVisible();await page.getByRole('button',{name:'Confirmar corte',exact:true}).click();await expect(page.getByRole('heading',{name:'Corte guardado · ',exact:false})).toBeVisible();corteNuevo=(await page.getByRole('heading',{name:'Corte guardado · ',exact:false}).innerText()).split(' · ')[1];await page.getByText('Fuentes y versiones incluidas (9)',{exact:true}).click();await expect(page.getByRole('row').filter({hasText:f.salida}).filter({hasText:'Candidato pendiente'})).toContainText('10.00 ud físico · 7.00 ud repartido · 3.00 ud pendiente');for(const id of[f.sobrante,f.roto,f.baja,f.devolucionExceso])await expect(page.getByRole('row').filter({hasText:id}).filter({hasText:'Movimiento excluido'})).toContainText('PRUEBA-CORRECCION05 fuera alcance '+id);await page.screenshot({path:resolve(dir,'02-exclusiones-residual-congelado.png'),fullPage:true});
  const r=await context.request.get('/api/costes/cortes/'+corteNuevo);expect(r.status()).toBe(200);await writeFile(resolve(dir,'corte-durable-antes.json'),JSON.stringify(await r.json(),null,2));await page.getByRole('button',{name:'Preparar una nueva revisión',exact:true}).click();await expect(page.getByLabel('Exclusiones: UUID de movimiento y motivo, una por línea',{exact:true})).toHaveValue(excluidos);
 });
 test('P2-02 escritorio: histórico>50 y referencias previstas/reales de páginas distintas conservadas sin loadall',async({page,context})=>{
  await entrar(context,p.admin);const llamadas:string[]=[];page.on('request',r=>{if(r.url().includes('modo=cortes'))llamadas.push(r.url());});await page.goto(`/proyectos/${p.proyecto}/costes`);await page.getByRole('button',{name:'Cargar cortes guardados',exact:true}).click();const historial=page.getByRole('region',{name:'Histórico de cortes',exact:true});await expect(historial.getByRole('button',{name:/^Abrir /})).toHaveCount(50);await historial.getByRole('button',{name:'Siguiente',exact:true}).click();await expect(historial.getByText(/Página 2/)).toBeVisible();await expect(historial.getByRole('button',{name:/^Abrir /})).toHaveCount(50);await historial.getByRole('button',{name:'Siguiente',exact:true}).click();await expect(historial.getByText(/Página 3/)).toBeVisible();await expect(historial.getByText(p.corteParcial,{exact:true})).toBeVisible();await historial.locator('p').filter({hasText:p.corteParcial}).getByRole('button',{name:/^Abrir /}).click();await expect(page.getByRole('heading',{name:'Corte guardado · '+p.corteParcial,exact:true})).toBeVisible();
  await page.getByLabel('Tipo de corte',{exact:true}).selectOption('comparacion');await page.getByRole('button',{name:'Siguiente previsto',exact:true}).click();await expect(page.getByText('Página 2 · 51 cortes previsto',{exact:true})).toBeVisible();await page.getByLabel('Corte previsto de referencia',{exact:true}).selectOption(p.previstoPagina2);const realPrimero=await page.getByLabel('Corte real de referencia',{exact:true}).locator('option').nth(1).getAttribute('value');expect(realPrimero).toBeTruthy();await page.getByLabel('Corte real de referencia',{exact:true}).selectOption(realPrimero!);await page.getByRole('button',{name:'Anterior previsto',exact:true}).click();await expect(page.getByLabel('Corte previsto de referencia',{exact:true})).toHaveValue(p.previstoPagina2);await page.getByRole('button',{name:'Siguiente real',exact:true}).click();await page.getByLabel('Corte real de referencia',{exact:true}).selectOption(p.realPagina2);await page.getByRole('button',{name:'Anterior real',exact:true}).click();await expect(page.getByLabel('Corte real de referencia',{exact:true})).toHaveValue(p.realPagina2);await page.getByLabel('Motivo del corte',{exact:true}).fill('PRUEBA-CORRECCION05 referencias paginadas');await page.getByLabel('Laboral',{exact:true}).uncheck();await page.getByRole('button',{name:'Preparar corte',exact:true}).click();await expect(page.getByRole('button',{name:'Confirmar corte',exact:true})).toBeVisible();await page.screenshot({path:resolve(dir,'03-referencias-paginas-distintas.png'),fullPage:true});expect(await page.getByLabel('Corte real de referencia',{exact:true}).locator('option').count()).toBeLessThanOrEqual(52);expect(await page.getByLabel('Corte previsto de referencia',{exact:true}).locator('option').count()).toBeLessThanOrEqual(52);expect(llamadas.filter(x=>x.includes('tipoCorte=real')&&x.includes('pagina=2')).length).toBe(1);expect(llamadas.filter(x=>x.includes('tipoCorte=previsto')&&x.includes('pagina=2')).length).toBe(1);await writeFile(resolve(dir,'peticiones-paginadas.json'),JSON.stringify(llamadas,null,2));
 });
 test('Histórico antiguo no inventa datos; privacidad HTTP/HTML/RSC; cierre móvil después de escritorio',async({page,context})=>{
  await entrar(context,p.legacyAdmin);const legacy=await context.request.get('/api/costes/cortes/'+p.legacyCorte);expect(legacy.status()).toBe(200);const l=await legacy.json();await page.goto(`/proyectos/${l.proyectoId}/costes`);await page.getByRole('button',{name:'Cargar cortes guardados',exact:true}).click();const historial=page.getByRole('region',{name:'Histórico de cortes',exact:true});await historial.locator('p').filter({hasText:p.legacyCorte}).getByRole('button',{name:/^Abrir /}).click();await expect(page.getByText(/4 excluidos con motivo/)).toBeVisible();await page.getByText(/Fuentes y versiones incluidas/).click();await expect(page.getByRole('row').filter({hasText:'Movimiento excluido'})).toHaveCount(4);await expect(page.getByRole('row').filter({hasText:'Movimiento excluido'}).first()).toContainText('detalle físico no congelado');await page.screenshot({path:resolve(dir,'04-historico-legado-honesto.png'),fullPage:true});
  const privados=/precioHora|importeMinor|valoracionActualId|"totales"|PRUEBA-CORRECCION05 fuente neta/;for(const id of[f.lectura,f.gestor]){await entrar(context,id);for(const ruta of[`/api/costes/proyectos/${f.proyecto}?modo=cortes&pagina=2`,`/api/costes/proyectos/${f.proyecto}?modo=cortes&tipoCorte=real&pagina=2`,`/api/costes/cortes/${corteNuevo}`]){const r=await context.request.get(ruta);expect(r.status()).toBe(403);expect(await r.text()).not.toMatch(privados);}for(const rsc of[false,true]){const r=await context.request.get(`/proyectos/${f.proyecto}/costes`,{headers:rsc?{RSC:'1','Next-Router-Prefetch':'1'}:{}});const body=await r.text();expect(body).not.toMatch(privados);await writeFile(resolve(dir,`privacidad-${id}-${rsc?'rsc':'html'}.txt`),body);}}
