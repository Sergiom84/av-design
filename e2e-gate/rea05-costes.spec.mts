import { test,expect,type BrowserContext } from '@playwright/test';
import { mkdir,writeFile } from 'node:fs/promises';
import { resolve } from 'node:path';
import { conectarRevisiones,URL_REA_PRUEBA,fotografiarRevisiones,type SqlRevisionesPrueba } from '../scripts/rea05-costes-fixture.mjs';
import { crearDatosCostes } from '../scripts/rea05-costes-datos.mjs';
import { COOKIE_SESION,firmarSesion } from '../src/lib/sesion';
const salida=resolve('output/rea-integracion/rea05/costes-runtime',process.env.REA05_COSTES_EVIDENCIA??'e2e');
let c:SqlRevisionesPrueba,f:Awaited<ReturnType<typeof crearDatosCostes>>,foto:Awaited<ReturnType<typeof fotografiarRevisiones>>;
const secreto='rea05-costes-local-prueba-integracion-2026';
async function entrar(context:BrowserContext,id:string){await context.clearCookies();await context.addCookies([{name:COOKIE_SESION,value:await firmarSesion(secreto,Date.now()+3600000,id),domain:'localhost',path:'/',httpOnly:true,sameSite:'Lax'}]);}
test.describe.serial('Costes05: escritorio completo, privacidad y cierre móvil',()=>{
 test.beforeAll(async()=>{expect(process.env.REA05_COSTES_DATABASE_URL).toBe(URL_REA_PRUEBA);c=await conectarRevisiones(URL_REA_PRUEBA);f=await crearDatosCostes(c);await mkdir(salida,{recursive:true});foto=await fotografiarRevisiones(c);await writeFile(resolve(salida,'antes.json'),JSON.stringify(foto,null,2));await writeFile(resolve(salida,'fixture.json'),JSON.stringify(f,null,2));});
 test.afterAll(async()=>{if(c){const despues=await fotografiarRevisiones(c);await writeFile(resolve(salida,'despues.json'),JSON.stringify(despues,null,2));for(const t of foto.tablas.filter(t=>!t.tabla.startsWith('coste_')))expect(despues.tablas.find(f=>f.tabla===t.tabla)?.sha256,t.tabla).toBe(t.sha256);await c.end();}});
 test('Escritorio: tarifa posterior, valorar, pendiente/conciliado y cortes reales',async({page,context})=>{
  await entrar(context,f.admin);const errores:string[]=[];page.on('pageerror',e=>errores.push(e.message));await page.goto(`/proyectos/${f.proyecto}/costes`);await expect(page.getByRole('heading',{name:'Costes registrados · '+f.nombre+' obra',exact:true})).toBeVisible();
  await page.getByRole('button',{name:'Cargar partes sin valorar y valorados',exact:true}).click();await page.getByLabel('Valorar parte '+f.registro,{exact:true}).check();await page.getByLabel('Motivo de valoración laboral',{exact:true}).fill('PRUEBA UI sin tarifa');await page.getByRole('button',{name:'Preparar valoración de seleccionados (1)',exact:true}).click();await expect(page.getByText('2026-10-14 · 90 min · Sin tarifa',{exact:true})).toBeVisible();await page.screenshot({path:resolve(salida,'01-sin-tarifa-escritorio.png'),fullPage:true});await page.getByRole('button',{name:'Confirmar valoración laboral',exact:true}).click();await expect(page.getByText('Valoraciones congeladas.',{exact:true})).toBeVisible();
  await page.getByLabel('Buscar técnico para tarifa',{exact:true}).fill(f.nombre+' técnico');await page.getByRole('button',{name:'Buscar técnicos',exact:true}).click();await page.getByLabel('Técnico de la tarifa',{exact:true}).selectOption(f.tecnico);await page.getByLabel('Vigente desde',{exact:true}).fill('2026-01-01');await page.getByLabel('Importe por hora',{exact:true}).fill('20.0000');await page.getByLabel('Calidad de tarifa',{exact:true}).selectOption('validada');await page.getByLabel('Fuente de tarifa',{exact:true}).fill('PRUEBA PRIVADO FINANCIERO 05');await page.getByLabel('Motivo de tarifa',{exact:true}).fill('PRUEBA UI tarifa posterior');await page.getByRole('button',{name:'Revisar tarifa',exact:true}).click();await page.getByRole('button',{name:'Confirmar tarifa',exact:true}).click();await expect(page.getByText('Versión de tarifa guardada.',{exact:true})).toBeVisible();
  await page.getByRole('button',{name:'Cargar partes sin valorar y valorados',exact:true}).click();await page.getByLabel('Valorar parte '+f.registro,{exact:true}).check();await page.getByLabel('Motivo de valoración laboral',{exact:true}).fill('PRUEBA UI tarifa exacta');await page.getByRole('button',{name:'Preparar valoración de seleccionados (1)',exact:true}).click();await expect(page.getByText('30.00 EUR',{exact:true})).toBeVisible();await page.getByRole('button',{name:'Confirmar valoración laboral',exact:true}).click();await expect(page.getByText('Valoraciones congeladas.',{exact:true})).toBeVisible();
  await page.getByRole('button',{name:'Buscar movimientos',exact:true}).click();const fila=page.getByRole('row').filter({hasText:f.salida});await fila.getByRole('button',{name:'Asociar salida',exact:true}).click();await page.getByLabel('Motivo de apunte',{exact:true}).fill('PRUEBA UI apunte pendiente');await page.getByRole('button',{name:'Preparar asociación material',exact:true}).click();await page.getByRole('button',{name:'Confirmar apunte material',exact:true}).click();await expect(page.getByText('Apunte material guardado. Los hechos físicos permanecen en su fuente.',{exact:true})).toBeVisible();
  await fila.getByRole('button',{name:'Historial de apunte',exact:true}).click();await page.getByRole('button',{name:'Corregir o anular este apunte',exact:true}).click();await page.getByLabel('Calidad material',{exact:true}).selectOption('documentado');await page.getByLabel('Precio unitario histórico',{exact:true}).fill('10.0000');await page.getByLabel('Moneda material',{exact:true}).selectOption('EUR');await page.getByLabel('Documento histórico de adquisición',{exact:true}).fill('PRUEBA documento explícito UI');await page.getByLabel('Fecha de adquisición confirmada',{exact:true}).fill('2026-10-13');await page.getByLabel('Motivo de apunte',{exact:true}).fill('PRUEBA UI conciliación revisada');await page.getByRole('button',{name:'Preparar asociación material',exact:true}).click();await expect(page.getByText('100.00 EUR',{exact:false}).first()).toBeVisible();await page.screenshot({path:resolve(salida,'02-material-conciliado-escritorio.png'),fullPage:true});await page.getByRole('button',{name:'Confirmar apunte material',exact:true}).click();
  await page.getByLabel('Motivo del corte',{exact:true}).fill('PRUEBA UI corte real parcial revisado');await page.getByRole('button',{name:'Preparar corte',exact:true}).click();await expect(page.getByText('real · parcial',{exact:false})).toBeVisible();await page.getByRole('button',{name:'Confirmar corte',exact:true}).click();await expect(page.getByRole('heading',{name:'Corte guardado · ',exact:false})).toBeVisible();await page.getByRole('button',{name:'Comparar original con fuentes actuales',exact:true}).click();await expect(page.getByRole('heading',{name:'Fuentes actuales del mismo alcance',exact:true})).toBeVisible();await page.screenshot({path:resolve(salida,'03-corte-real-escritorio.png'),fullPage:true});
  await page.getByLabel('Tipo de corte',{exact:true}).selectOption('previsto');await page.getByLabel('Motivo del corte',{exact:true}).fill('PRUEBA UI corte previsto');await page.getByRole('button',{name:'Preparar corte',exact:true}).click();await expect(page.getByText('previsto · completo',{exact:false})).toBeVisible();await page.getByRole('button',{name:'Confirmar corte',exact:true}).click();await page.getByLabel('Tipo de corte',{exact:true}).selectOption('comparacion');await page.getByLabel('Motivo del corte',{exact:true}).fill('PRUEBA UI comparación sin diferencia por parcial');await page.getByLabel('Corte previsto de referencia',{exact:true}).selectOption({index:1});await page.getByLabel('Corte real de referencia',{exact:true}).selectOption({index:1});await page.getByRole('button',{name:'Preparar corte',exact:true}).click();await expect(page.getByText('Cobertura o moneda no comparable',{exact:false})).toBeVisible();await page.getByRole('button',{name:'Confirmar corte',exact:true}).click();await page.screenshot({path:resolve(salida,'04-comparacion-escritorio.png'),fullPage:true});expect(errores).toEqual([]);
 });
 test('HTTP/HTML/RSC: lectura/compras y gestor sin datos privados; revocación inmediata',async({context,page})=>{
  const hallazgos:Array<{usuario:string;ruta:string;estado:number}>=[];
  const privados=/PRUEBA PRIVADO FINANCIERO 05|precio_hora|precioHora|importeMinor|valoracionActualId|"totales"|"estimados"|minutosPendientes/;
  for(const usuario of[f.lectura,f.gestor,f.trabajador]){await entrar(context,usuario);for(const ruta of[`/api/costes/tarifas`,`/api/costes/laboral/partes?proyectoId=${f.proyecto}&desde=2026-10-14&hasta=2026-10-14`,`/api/costes/material/candidatos?proyectoId=${f.proyecto}&desde=2026-10-14&hasta=2026-10-14`,`/api/costes/proyectos/${f.proyecto}?desde=2026-10-14&hasta=2026-10-14`]){const r=await context.request.get(ruta),body=await r.text();expect(r.status()).toBe(403);expect(body).not.toMatch(privados);hallazgos.push({usuario,ruta,estado:r.status()});}for(const rsc of[false,true]){const r=await context.request.get(`/proyectos/${f.proyecto}/costes`,{headers:rsc?{RSC:'1','Next-Router-Prefetch':'1'}:{}}),body=await r.text();expect(body).not.toMatch(privados);await writeFile(resolve(salida,`privacidad-${usuario}-${rsc?'rsc':'html'}.txt`),body);}await page.goto(`/proyectos/${f.proyecto}/costes`);await expect(page.getByText('Acceso no disponible.',{exact:true})).toBeVisible();expect(await page.getByLabel('Importe por hora',{exact:true}).count()).toBe(0);}
  await entrar(context,f.admin);const sinOrigen=await context.request.post('/api/costes/laboral/preparar',{data:{}});expect(sinOrigen.status()).toBe(403);const gigante=await context.request.post('/api/costes/laboral/preparar',{headers:{Origin:'http://localhost:3117','Content-Type':'application/json'},data:JSON.stringify({relleno:'x'.repeat(66000)})});expect(gigante.status()).toBe(413);expect(await gigante.text()).not.toMatch(/select|password|stack|postgres:\/\//i);
  const valid=await context.request.get('/api/costes/tarifas');expect(valid.ok()).toBeTruthy();await c`update usuarios set rol='lectura' where id=${f.admin}`;expect((await context.request.get('/api/costes/tarifas')).status()).toBe(403);expect((await context.request.post('/api/costes/laboral/preparar',{headers:{Origin:'http://localhost:3117'},data:{partes:[{registroId:f.registro,versionId:f.versionTiempo}],motivo:'PRUEBA revocación'}})).status()).toBe(403);await c`update usuarios set rol='admin' where id=${f.admin}`;
  await writeFile(resolve(salida,'privacidad-http.json'),JSON.stringify(hallazgos,null,2));
 });

 test('API tardía,400 y409 conservan el borrador y no confirman selección anterior',async({context,page})=>{
  await entrar(context,f.admin);await page.goto(`/proyectos/${f.proyecto}/costes`);await page.getByRole('button',{name:'Buscar movimientos',exact:true}).click();const fila=page.getByRole('row').filter({hasText:f.salidaCarrera});await fila.getByRole('button',{name:'Asociar salida',exact:true}).click();await page.getByLabel('Motivo de apunte',{exact:true}).fill('PRUEBA primera edición tardía');
  let liberar!:()=>void,recibida!:()=>void;const espera=new Promise<void>(r=>{liberar=r;}),preparada=new Promise<void>(r=>{recibida=r;});
  await page.route('**/api/costes/material/preparar',async ruta=>{const r=await ruta.fetch();recibida();await espera;await ruta.fulfill({response:r});});
  await page.getByRole('button',{name:'Preparar asociación material',exact:true}).click();await preparada;await page.getByLabel('Motivo de apunte',{exact:true}).fill('PRUEBA edición posterior conservada');liberar();await expect(page.getByText('Apunte preparado. Revisa evidencia, cantidad y linaje.',{exact:true})).toBeVisible();await expect(page.getByRole('button',{name:'Confirmar apunte material',exact:true})).toHaveCount(0);await expect(page.getByLabel('Motivo de apunte',{exact:true})).toHaveValue('PRUEBA edición posterior conservada');await page.unroute('**/api/costes/material/preparar');
  await page.getByLabel('Precio unitario histórico',{exact:true}).fill('1e3');await page.getByRole('button',{name:'Preparar asociación material',exact:true}).click();await expect(page.getByRole('alert').filter({hasText:'Comprueba los campos'})).toBeVisible();await expect(page.getByLabel('Precio unitario histórico',{exact:true})).toHaveValue('1e3');await page.getByLabel('Precio unitario histórico',{exact:true}).fill('');
  await page.getByRole('button',{name:'Preparar asociación material',exact:true}).click();await expect(page.getByRole('button',{name:'Confirmar apunte material',exact:true})).toBeVisible();
  const headers={Origin:'http://localhost:3117'},entrada={movimientoId:f.salidaCarrera,proyectoId:f.proyecto,salaId:f.sala,cantidad:'10',unidad:'ud',calidad:'sin_valorar',precioUnitario:null,moneda:null,linaje:'salida',evidencia:{},motivo:'PRUEBA segunda conexión financiera'};
  const previa=await context.request.post('/api/costes/material/preparar',{headers,data:{apuntes:[entrada]}});expect(previa.status()).toBe(200);const p=await previa.json();const confirmar=await context.request.post('/api/costes/material/confirmar',{headers,data:{seleccion:p.seleccion,token:p.token,clavePeticion:crypto.randomUUID()}});expect(confirmar.status()).toBe(201);
  await page.getByRole('button',{name:'Confirmar apunte material',exact:true}).click();await expect(page.getByRole('alert').filter({hasText:'supera el movimiento físico'})).toBeVisible();await expect(page.getByLabel('Motivo de apunte',{exact:true})).toHaveValue('PRUEBA edición posterior conservada');await expect(page.getByLabel('Cantidad imputada (ud)',{exact:true})).toHaveValue('10.00');await page.screenshot({path:resolve(salida,'05-conflicto-conserva-borrador.png'),fullPage:true});
 });
 test('Cierre móvil después del recorrido de escritorio: controles y ancho',async({context,page})=>{
  await entrar(context,f.admin);await page.setViewportSize({width:390,height:844});await page.goto(`/proyectos/${f.proyecto}/costes`);await expect(page.getByRole('heading',{name:'Costes registrados · '+f.nombre+' obra',exact:true})).toBeVisible();await page.getByRole('button',{name:'Cargar partes sin valorar y valorados',exact:true}).click();await expect(page.getByLabel('Motivo de valoración laboral',{exact:true})).toBeVisible();const ancho=await page.evaluate(()=>({documento:document.documentElement.scrollWidth,viewport:innerWidth}));expect(ancho.documento).toBeLessThanOrEqual(ancho.viewport);await page.screenshot({path:resolve(salida,'06-movil-cierre.png'),fullPage:true});
 });
