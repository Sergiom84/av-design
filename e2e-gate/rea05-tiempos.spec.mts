import { test, expect, type BrowserContext } from '@playwright/test';
import { writeFile } from 'node:fs/promises';
import { resolve } from 'node:path';
import { firmarSesion, COOKIE_SESION } from '../src/lib/sesion';
import { conectarRevisiones, URL_REA_PRUEBA, idTR, SALIDA_TIEMPOS, SECRETO_TIEMPOS, fotoTiempos } from '../scripts/rea05-tiempos-fixture.mjs';
let c: Awaited<ReturnType<typeof conectarRevisiones>>, dia:string;
let fotos: Awaited<ReturnType<typeof fotoTiempos>>;
async function entrar(context:BrowserContext,n=2){await context.clearCookies();await context.addCookies([{name:COOKIE_SESION,value:await firmarSesion(SECRETO_TIEMPOS,Date.now()+3600000,idTR(n)),domain:'localhost',path:'/',httpOnly:true,sameSite:'Lax'}]);}
test.describe.serial('REA05 tiempos · escritorio completo antes de móvil',()=>{
 test.beforeAll(async()=>{if(process.env.REA_DATABASE_URL!==URL_REA_PRUEBA)throw new Error('Destino05 explícito');c=await conectarRevisiones(process.env.REA_DATABASE_URL);const[{n}]=await c`select count(*)::int n from tiempo_registros where tecnico_id=${idTR(102)}`;dia=new Date(Date.UTC(2024,0,1+Number(n)*2)).toISOString().slice(0,10);fotos=await fotoTiempos(c,'antes-chrome');});
 test.afterAll(async()=>{if(c){const despues=await fotoTiempos(c,'despues-chrome');const excepciones=new Set(['tiempo_registros','tiempo_versiones','tiempo_operaciones','usuario_permisos']);expect(fotos.tablas.filter(t=>!excepciones.has(t.tabla)&&JSON.stringify(t)!==JSON.stringify(despues.tablas.find(d=>d.tabla===t.tabla)))).toEqual([]);await c.end();}});
 test('01 escritorio trabajador registra, corrige, anula, restaura e historial',async({page,context})=>{
  await entrar(context);await page.goto('/cuenta/tiempos');await expect(page.getByRole('heading',{name:'Mis tiempos',exact:true})).toBeVisible();
  await page.getByLabel('Buscar tarea para parte').fill('tarea 1-1');await page.getByRole('button',{name:'Buscar tareas',exact:true}).click();await page.getByRole('button',{name:'PRUEBA-REA05-TIEMPOS tarea 1-1 · PRUEBA-REA05-TIEMPOS obra 1 · PRUEBA-REA05-TIEMPOS sala 1',exact:true}).click();
  await page.getByLabel('Fecha de inicio',{exact:true}).fill(dia);await page.getByLabel('Hora de inicio',{exact:true}).fill('09:00');await page.getByLabel('Fecha de fin',{exact:true}).fill(dia);await page.getByLabel('Hora de fin',{exact:true}).fill('10:00');await page.getByLabel('Notas del parte',{exact:true}).fill('Trabajo real Chrome');await page.getByRole('button',{name:'Registrar parte',exact:true}).click();await expect(page.getByText('Parte registrado.',{exact:true})).toBeVisible();
  await page.getByLabel('Partes desde').fill(dia);await page.getByLabel('Partes hasta').fill(dia);await page.getByRole('button',{name:'Consultar partes',exact:true}).click();await page.getByRole('button',{name:`Abrir parte ${dia} 09:00`,exact:true}).click();
  const ficha=page.locator('section').filter({has:page.getByRole('heading',{name:'Parte · PRUEBA-REA05-TIEMPOS tarea 1-1',exact:true})});
  await ficha.getByLabel('Corregir notas del parte').fill('Chrome corregido');await ficha.getByLabel('Motivo de corrección o anulación').fill('Corrección observada en escritorio');await ficha.getByRole('button',{name:'Guardar corrección',exact:true}).click();await expect(ficha.getByText('Nueva versión guardada.',{exact:true})).toBeVisible();
  await ficha.getByLabel('Motivo de corrección o anulación').fill('Anulación observada');await ficha.getByRole('button',{name:'Anular parte',exact:true}).click();await expect(ficha.getByText(/Versión 3.*Anulado/)).toBeVisible();
  await ficha.getByLabel('Motivo de corrección o anulación').fill('Restauración explícita');await ficha.getByRole('button',{name:'Consultar historial del parte',exact:true}).click();await ficha.getByRole('button',{name:'Restaurar intervalo de versión 1',exact:true}).click();await expect(ficha.getByText(/Versión 4.*Vigente/)).toBeVisible();
  await ficha.getByRole('button',{name:'Consultar historial del parte',exact:true}).click();await expect(ficha.getByText('Versiones del parte',{exact:true})).toBeVisible();await page.evaluate(()=>window.scrollTo(0,0));await page.screenshot({path:resolve(SALIDA_TIEMPOS,'escritorio-trabajador-historial.png'),fullPage:true});
 });
 test('02 escritorio gestor explícito y error seguro por solapamiento conserva formulario',async({page,context})=>{
  await entrar(context,3);await page.goto('/proyectos/'+idTR(201)+'/tiempos');await expect(page.getByRole('heading',{name:'Gestión de tiempos',exact:true})).toBeVisible();
  await page.getByLabel('Buscar tarea para parte').fill('tarea 1-1');await page.getByRole('button',{name:'Buscar tareas',exact:true}).click();await page.getByRole('button',{name:/^PRUEBA-REA05-TIEMPOS tarea 1-1 ·/}).click();await page.getByLabel('Buscar técnico para parte').fill('técnico 2');await page.getByRole('button',{name:'Buscar técnicos',exact:true}).click();await page.getByRole('button',{name:'PRUEBA-REA05-TIEMPOS técnico 2',exact:true}).click();
  await page.getByLabel('Fecha de inicio',{exact:true}).fill(dia);await page.getByLabel('Hora de inicio',{exact:true}).fill('09:30');await page.getByLabel('Fecha de fin',{exact:true}).fill(dia);await page.getByLabel('Hora de fin',{exact:true}).fill('10:30');await page.getByLabel('Notas del parte').fill('Se conserva tras409');await page.getByLabel('Motivo del parte').fill('Gestor explícito comprueba intervalo');await page.getByRole('button',{name:'Registrar parte',exact:true}).click();await expect(page.getByRole('alert').filter({hasText:'ya tiene trabajo real'})).toBeVisible();await expect(page.getByLabel('Notas del parte')).toHaveValue('Se conserva tras409');
  await page.getByLabel('Hora de inicio',{exact:true}).fill('10:00');await page.getByLabel('Hora de fin',{exact:true}).fill('11:00');await page.getByRole('button',{name:'Registrar parte',exact:true}).click();await expect(page.getByText('Parte registrado.',{exact:true})).toBeVisible();await page.evaluate(()=>window.scrollTo(0,0));await page.screenshot({path:resolve(SALIDA_TIEMPOS,'escritorio-gestor.png'),fullPage:true});
  const html=await page.content();expect(html).not.toMatch(/precio_hora|importeMinor|coste_tarifa|moneda/i);await writeFile(resolve(SALIDA_TIEMPOS,'gestor-html.html'),html);
 });
 test('03 retirada RSC neutraliza una respuesta previa suspendida',async({page,context})=>{
  await entrar(context);await page.goto('/cuenta/tiempos');await page.getByLabel('Partes desde').fill(dia);await page.getByLabel('Partes hasta').fill(dia);await page.getByRole('button',{name:'Consultar partes',exact:true}).click();await expect(page.getByRole('button',{name:`Abrir parte ${dia} 09:00`,exact:true})).toBeVisible();
  let liberar!:()=>void;const pausa=new Promise<void>(r=>liberar=r);let tomada!:()=>void;const capturada=new Promise<void>(r=>tomada=r);
  await page.route('**/api/tiempos/mios?**',async route=>{const respuesta=await route.fetch();tomada();await pausa;await route.fulfill({response:respuesta});});
  await page.getByRole('button',{name:'Consultar partes',exact:true}).click();await capturada;
  await c`update usuario_permisos set acceso='oculto' where usuario_id=${idTR(2)} and seccion='salas'`;
  try{await page.getByRole('button',{name:'Actualizar acceso y contexto',exact:true}).click();await expect(page.getByRole('button',{name:`Abrir parte ${dia} 09:00`,exact:true})).toHaveCount(0);liberar();await expect(page.getByRole('button',{name:`Abrir parte ${dia} 09:00`,exact:true})).toHaveCount(0);await page.evaluate(()=>window.scrollTo(0,0));await page.screenshot({path:resolve(SALIDA_TIEMPOS,'escritorio-retirada-acl.png'),fullPage:true});}
  finally{liberar();await c`update usuario_permisos set acceso='ver' where usuario_id=${idTR(2)} and seccion='salas'`;}
 });
 test('04 escritorio reclasifica conservando enlaces de ambos partes',async({page,context})=>{
  await entrar(context);const fecha=new Date(Date.parse(dia)+86400000).toISOString().slice(0,10);
  const r=await page.request.post('/api/tiempos/mios',{headers:{Origin:'http://localhost:3115'},data:{tareaId:idTR(311),inicio:{fecha,hora:'09:00'},fin:{fecha,hora:'10:00'},clavePeticion:crypto.randomUUID()}});expect(r.status()).toBe(201);
  await page.goto('/cuenta/tiempos');await page.getByLabel('Partes desde').fill(fecha);await page.getByLabel('Partes hasta').fill(fecha);await page.getByRole('button',{name:'Consultar partes',exact:true}).click();await page.getByRole('button',{name:`Abrir parte ${fecha} 09:00`,exact:true}).click();
  await page.getByLabel('Motivo de corrección o anulación').fill('Tarea errónea, corregir con nueva cabecera');await page.getByRole('button',{name:'Anular parte',exact:true}).click();await expect(page.getByText(/Versión 2.*Anulado/)).toBeVisible();await page.getByRole('button',{name:'Crear parte corregido relacionado',exact:true}).click();
  await page.getByLabel('Buscar tarea para parte').fill('tarea 1-2');await page.getByRole('button',{name:'Buscar tareas',exact:true}).click();await page.getByRole('button',{name:/^PRUEBA-REA05-TIEMPOS tarea 1-2 ·/}).click();
  const formulario=page.locator('section').filter({has:page.getByRole('heading',{name:'Registrar trabajo real',exact:true})});
  await formulario.getByLabel('Fecha de inicio',{exact:true}).fill(fecha);await formulario.getByLabel('Hora de inicio',{exact:true}).fill('10:00');await formulario.getByLabel('Fecha de fin',{exact:true}).fill(fecha);await formulario.getByLabel('Hora de fin',{exact:true}).fill('11:00');await formulario.getByLabel('Motivo del parte').fill('Tarea correcta revisada');await formulario.getByRole('button',{name:'Registrar parte',exact:true}).click();await expect(formulario.getByText('Parte registrado.',{exact:true})).toBeVisible();
  await page.getByRole('button',{name:`Abrir parte ${fecha} 10:00`,exact:true}).click();await page.getByRole('button',{name:'Consultar partes relacionados',exact:true}).click();await page.getByRole('button',{name:`PRUEBA-REA05-TIEMPOS tarea 1-1 · PRUEBA-REA05-TIEMPOS técnico 2 · ${fecha} 09:00`,exact:true}).click();await expect(page.getByRole('heading',{name:'Parte · PRUEBA-REA05-TIEMPOS tarea 1-1',exact:true})).toBeVisible();await page.getByRole('button',{name:'Consultar partes relacionados',exact:true}).click();await expect(page.getByRole('button',{name:`PRUEBA-REA05-TIEMPOS tarea 1-2 · PRUEBA-REA05-TIEMPOS técnico 2 · ${fecha} 10:00`,exact:true})).toBeVisible();await page.evaluate(()=>window.scrollTo(0,0));await page.evaluate(()=>window.scrollTo(0,0));await page.screenshot({path:resolve(SALIDA_TIEMPOS,'escritorio-reclasificacion-relacionada.png'),fullPage:true});
 });
 test('05 móvil de cierre: partes, historial y formulario sin desbordamiento',async({page,context})=>{
  await entrar(context);await page.setViewportSize({width:390,height:844});await page.goto('/cuenta/tiempos');await page.getByLabel('Partes desde').fill(dia);await page.getByLabel('Partes hasta').fill(dia);await page.getByRole('button',{name:'Consultar partes',exact:true}).click();await page.getByRole('button',{name:`Abrir parte ${dia} 09:00`,exact:true}).click();await page.getByRole('button',{name:'Consultar historial del parte',exact:true}).click();await expect(page.getByText('Versiones del parte',{exact:true})).toBeVisible();expect(await page.evaluate(()=>document.documentElement.scrollWidth<=window.innerWidth)).toBeTruthy();await page.evaluate(()=>window.scrollTo(0,0));await page.screenshot({path:resolve(SALIDA_TIEMPOS,'movil-cierre.png'),fullPage:true});
 });
