import { test, expect, type BrowserContext } from '@playwright/test';
import { readFile, mkdir, writeFile } from 'node:fs/promises';
import { resolve } from 'node:path';
import { createHash } from 'node:crypto';
import { COOKIE_SESION, firmarSesion } from '../src/lib/sesion';
import { conectarRevisiones, URL_REA_PRUEBA, idPropuesta } from '../scripts/rea06-fixture.mjs';
const salida = resolve('output/rea-integracion/rea06/navegador'), sala = idPropuesta(12);
const ruta = `/salas/${sala}/propuestas`;
let publicada = '';
const titulo = `Propuesta navegador REA06 ${Date.now()}`;
async function entrar(context: BrowserContext, n = 1) { await context.clearCookies(); await context.addCookies([{ name: COOKIE_SESION, value: await firmarSesion('rea06-local-prueba-integracion-secreto-2026', Date.now() + 3600000, idPropuesta(n)), domain: 'localhost', path: '/', httpOnly: true, sameSite: 'Lax' }]); }
test.describe.configure({ mode: 'serial' });
test.beforeAll(async () => { await mkdir(salida, { recursive: true }); });
test('01 escritorio: alcance,destinatario,valoración prevista,PDF durable', async ({ page, context }) => {
    await entrar(context);
    const errores: string[] = [];
    page.on('pageerror', e => errores.push(e.message));
    await page.goto(ruta);
    await expect(page.getByRole('heading', { name: 'Propuestas internas', exact: true })).toBeVisible();
    await page.getByLabel('Título', { exact: true }).fill(titulo);
    await page.getByLabel('Texto de sección 1', { exact: true }).fill('Instalación para {{destinatario.nombre}} en {{sala.nombre}}.');
    await page.getByLabel('Acepto usar la revisión histórica seleccionada si ya cambió el diseño').check();
    await page.getByRole('button', { name: 'Revisar vista previa', exact: true }).click();
    await expect(page.getByRole('region', { name: 'Vista previa de propuesta' })).toBeVisible();
    await page.getByLabel('Añadir destinatario opcional').check();
    await page.getByLabel('Destinatario · nombre', { exact: true }).fill('Persona de prueba');
    await page.getByLabel('Destinatario · contacto').fill('Contacto interno sintético');
    await page.getByLabel('Incluir valoración prevista').check();
    await page.getByLabel('Coste unitario previsto', { exact: true }).fill('100');
    await page.getByRole('combobox', { name: 'Regla de precio', exact: true }).selectOption('margen');
    await page.getByLabel('Porcentaje de margen').fill('20');
    await page.getByRole('combobox', { name: 'Impuesto', exact: true }).selectOption('no_aplica');
    await page.getByLabel('Motivo de no aplicación').fill('Decisión explícita sintética');
    await page.getByRole('button', { name: 'Revisar vista previa', exact: true }).click();
    await expect(page.getByText('Base: 125.00 EUR', { exact: false })).toBeVisible();
    await page.screenshot({ path: resolve(salida, '01-escritorio-preview.png') });
    await page.getByRole('button', { name: 'Confirmar revisión y guardar PDF' }).click();
    await expect(page.getByRole('status')).toContainText('Revisión y PDF conservados');
    const a = page.getByRole('link', { name: /Abrir PDF conservado/ });
    await expect(a).toBeVisible();
    const href = await a.getAttribute('href');
    publicada = href!.split('/')[3];
    const r = await context.request.get(href!);
    expect(r.status()).toBe(200);
    const b = await r.body();
    expect(r.headers()['x-av-sha256']).toBe(createHash('sha256').update(b).digest('hex'));
    await writeFile(resolve(salida, 'propuesta-navegador.pdf'), b);
    await page.reload();
    await page.getByRole('button', { name: `${titulo} · revisión 1`, exact: true }).click();
    await expect(page.getByRole('link', { name: /Abrir PDF conservado/ })).toBeVisible();
    expect(errores).toEqual([]);
    await page.screenshot({ path: resolve(salida, '02-escritorio-reabierta.png') });
});
test('02 escritorio: conflicto conserva edición y preview tardío no la sustituye', async ({ page, context }) => {
    await entrar(context);
    await page.goto(ruta);
    await page.getByRole('button', { name: `${titulo} · revisión 1`, exact: true }).click();
    const otra = await context.newPage();
    await otra.goto(ruta);
    await otra.getByRole('button', { name: `${titulo} · revisión 1`, exact: true }).click();
    await page.getByLabel('Título', { exact: true }).fill(titulo + ' A');
    await otra.getByLabel('Título', { exact: true }).fill(titulo + ' B');
    await page.getByRole('button', { name: 'Revisar vista previa', exact: true }).click();
    await otra.getByRole('button', { name: 'Revisar vista previa', exact: true }).click();
    await expect(page.getByRole('button', { name: 'Confirmar revisión y guardar PDF' })).toBeVisible();
    await expect(otra.getByRole('button', { name: 'Confirmar revisión y guardar PDF' })).toBeVisible();
    await page.getByRole('button', { name: 'Confirmar revisión y guardar PDF' }).click();
    await expect(page.getByRole('status')).toContainText('conservados');
    await otra.getByRole('button', { name: 'Confirmar revisión y guardar PDF' }).click();
    await expect(otra.getByRole('alert').filter({ hasText: 'La propuesta' })).toContainText('cambió');
    await expect(otra.getByLabel('Título', { exact: true })).toHaveValue(titulo + ' B');
    await otra.screenshot({ path: resolve(salida, '03-conflicto-edicion.png') });
    await otra.close();
    await page.getByRole('button', { name: 'Nueva propuesta', exact: true }).click();
    await page.getByLabel('Título', { exact: true }).fill('Respuesta tardía original');
    await page.getByLabel('Acepto usar la revisión histórica seleccionada si ya cambió el diseño').check();
    let soltar: () => void = () => { };
    const espera = new Promise<void>(r => { soltar = r; });
    let recibida: () => void = () => { };
    const llegada = new Promise<void>(r => { recibida = r; });
    await page.route('**/api/propuestas/preparar', async (route) => { const r = await route.fetch(); recibida(); await espera; await route.fulfill({ response: r }); });
    await page.getByRole('button', { name: 'Revisar vista previa', exact: true }).click();
    await llegada;
    await page.getByLabel('Título', { exact: true }).fill('Edición posterior a preview');
    soltar();
    await page.waitForTimeout(500);
    await expect(page.getByRole('button', { name: 'Confirmar revisión y guardar PDF' })).toHaveCount(0);
    await expect(page.getByLabel('Título', { exact: true })).toHaveValue('Edición posterior a preview');
});
test('03 escritorio: lector,sin compras,retirada actual y API financiera/RSC', async ({ page, context }) => {
    const c = await conectarRevisiones(URL_REA_PRUEBA);
    try {
        await entrar(context, 3);
        await page.goto(ruta);
        await expect(page.getByLabel('Incluir valoración prevista')).toHaveCount(0);
        const datos = await readFile(resolve('output/rea-integracion/rea06/gates/sql-resultados.json'), 'utf8').then(JSON.parse);
        const id = datos.propuestas.valorada;
        expect((await context.request.get(`/api/propuestas/${id}`)).status()).toBe(403);
        expect((await context.request.get('/api/propuestas/precios?articuloId=' + idPropuesta(30))).status()).toBe(403);
        const lista = await context.request.get(`/api/propuestas?tipo=sala&id=${sala}`).then(r => r.json());
        expect(lista.propuestas.some((p: {
            id: string;
        }) => p.id === id)).toBe(false);
        expect(await page.content()).not.toContain('125.0000');
        await page.screenshot({ path: resolve(salida, '04-tecnico-sin-compras.png') });
        await entrar(context, 2);
        await page.reload();
        await expect(page.getByRole('button', { name: 'Nueva propuesta', exact: true })).toHaveCount(0);
        await expect(page.getByRole('button', { name: 'Revisar vista previa', exact: true })).toBeDisabled();
        await entrar(context);
        await page.reload();
        await page.getByRole('button', { name: titulo + ' A · revisión 2', exact: true }).click();
        await expect(page.getByLabel('Coste unitario previsto', { exact: true })).toHaveValue('100');
        // Retira compras al admin no es posible por política: se usa usuario real avanzado propio con compras autorizado temporalmente.
        await c `delete from usuario_permisos where usuario_id=${idPropuesta(3)} and seccion='compras'`;
        await entrar(context, 3);
        await page.reload();
        await page.getByRole('button', { name: titulo + ' A · revisión 2', exact: true }).click();
        await expect(page.getByLabel('Coste unitario previsto', { exact: true })).toHaveValue('100');
        let liberar: () => void = () => { }, avisar: () => void = () => { };
        const pendiente = new Promise<void>(r => { liberar = r; }), recibida = new Promise<void>(r => { avisar = r; });
        await page.route('**/api/propuestas/preparar', async (route) => { const r = await route.fetch(); avisar(); await pendiente; await route.fulfill({ response: r }); });
        await page.getByRole('button', { name: 'Revisar vista previa', exact: true }).click();
        await recibida;
        await c `insert into usuario_permisos(usuario_id,seccion,acceso) values(${idPropuesta(3)},'compras','oculto') on conflict(usuario_id,seccion) do update set acceso='oculto'`;
        await page.evaluate(() => window.dispatchEvent(new Event('focus')));
        await expect(page.getByLabel('Coste unitario previsto', { exact: true })).toHaveCount(0);
        await expect(page.getByRole('button', { name: 'Confirmar revisión y guardar PDF' })).toHaveCount(0);
        liberar();
        await page.waitForTimeout(300);
        await expect(page.getByLabel('Coste unitario previsto', { exact: true })).toHaveCount(0);
        expect((await context.request.get(`/api/propuestas/${publicada}`)).status()).toBe(403);
        await page.screenshot({ path: resolve(salida, '05-retirada-permiso.png') });
    }
    finally {
        await c `insert into usuario_permisos(usuario_id,seccion,acceso) values(${idPropuesta(3)},'compras','oculto') on conflict(usuario_id,seccion) do update set acceso='oculto'`;
        await c.end();
    }
});
test('04 cierre móvil después del flujo escritorio,teclado y errores', async ({ page, context }) => {
    await entrar(context, 3);
    await page.setViewportSize({ width: 390, height: 844 });
    await page.goto(ruta);
    await expect(page.getByRole('heading', { name: 'Propuestas internas', exact: true })).toBeVisible();
    await page.getByLabel('Título', { exact: true }).fill('Propuesta móvil');
    await page.getByLabel('Texto de sección 1', { exact: true }).fill('Móvil {{sala.nombre}}');
    await page.getByLabel('Acepto usar la revisión histórica seleccionada si ya cambió el diseño').check();
    await page.getByLabel('Título', { exact: true }).focus();
    await page.keyboard.press('Tab');
    expect(await page.evaluate(() => document.activeElement?.tagName)).not.toBe('BODY');
    await page.getByRole('button', { name: 'Revisar vista previa', exact: true }).click();
    await expect(page.getByRole('region', { name: 'Vista previa de propuesta' })).toBeVisible();
    expect(await page.evaluate(() => document.documentElement.scrollWidth <= window.innerWidth)).toBe(true);
    await page.screenshot({ path: resolve(salida, '06-movil-preview.png') });
});
