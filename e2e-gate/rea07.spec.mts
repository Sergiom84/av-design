import { test, expect, type BrowserContext } from '@playwright/test';
import { readFile, mkdir, writeFile } from 'node:fs/promises';
import { resolve } from 'node:path';
import { randomUUID } from 'node:crypto';
import { COOKIE_SESION, firmarSesion } from '../src/lib/sesion';
import { conectarRevisiones, URL_REA_PRUEBA } from '../scripts/rea07-fixture.mjs';
const salida = resolve(process.env.REA07_OUTPUT_DIR ?? 'output/rea-integracion/rea07/seguimiento-runtime', 'navegador'), f = JSON.parse(await readFile(resolve(process.env.REA07_FIXTURE_PATH ?? 'output/rea-integracion/rea07/seguimiento-runtime/manifest-fixture.json'), 'utf8'));
async function entrar(context: BrowserContext, usuario = f.admin) { await context.clearCookies(); await context.addCookies([{ name: COOKIE_SESION, value: await firmarSesion(f.secreto, Date.now() + 3600000, usuario), domain: 'localhost', path: '/', httpOnly: true, sameSite: 'Lax' }]); }
function payload(d: Record<string, unknown>, comando = 'emitir') { const revision = d.revision as { id: string; hash: string }; return { propuestaId: d.propuestaId, revisionId: revision.id, revisionHash: revision.hash, versionPropuesta: d.versionPropuesta, versionSeguimiento: d.versionSeguimiento, ultimoEventoId: d.ultimoEventoId, comando, decisionRevocadaId: null, motivo: 'Motivo HTTP de prueba', referencia: 'Acta HTTP sintética', clavePeticion: randomUUID() }; }
const filtros = (ids: string[]) => { const p = new URLSearchParams({ tipo: 'seleccion', desde: '2026-10-01', hasta: '2026-10-31', archivo: 'todas', observadoEn: new Date().toISOString(), importes: '0' }); for (const id of ids) p.append('propuesta', id); return p; };
test.describe.configure({ mode: 'serial' });
test.beforeAll(async () => { await mkdir(salida, { recursive: true }); });
test('01 HTTP real: identidad,origen,JSON64KiB,ACL ycapacidad05', async ({ context }) => {
    await entrar(context); const d = await context.request.get(`/api/seguimiento-propuestas/${f.grande[0]}`).then(r => r.json());
    expect((await context.request.post(`/api/seguimiento-propuestas/${f.grande[0]}`, { data: payload(d) })).status()).toBe(403);
    expect((await context.request.post(`/api/seguimiento-propuestas/${f.grande[0]}`, { headers: { Origin: 'https://otro.invalid', 'Content-Type': 'application/json' }, data: payload(d) })).status()).toBe(403);
    expect((await context.request.post(`/api/seguimiento-propuestas/${f.grande[0]}`, { headers: { Origin: 'http://localhost:3118', 'Content-Type': 'application/json' }, data: 'x'.repeat(65537) })).status()).toBe(413);
    expect((await context.request.get('/api/seguimiento-propuestas?capacidad=resultados')).status()).toBe(200);
    expect((await context.request.get('/api/seguimiento-propuestas/embudo?tipo=seleccion&desde=2026-02-30&hasta=2026-10-01&observadoEn=2026-10-15T00:00:00Z&propuesta=' + f.a.id)).status()).toBe(400);
    await entrar(context, f.gestor); expect((await context.request.get('/api/seguimiento-propuestas?capacidad=resultados')).status()).toBe(403);
    await entrar(context, f.tecnico); expect((await context.request.get(`/api/seguimiento-propuestas/${f.parcial.id}`)).status()).toBe(403);
    await entrar(context, 'd7000000-0000-4000-8000-000000000004'); expect((await context.request.get(`/api/seguimiento-propuestas/${f.a.id}`)).status()).toBe(403);
});
test('02 escritorio: emitir,aceptar,revocar,rechazar conhistoria yhash', async ({ page, context }) => {
    await entrar(context, f.tecnico); const errores: string[] = []; page.on('pageerror', e => errores.push(e.message));
    await page.goto(`/propuestas/seguimiento?propuesta=${f.grande[0]}`); const region = page.getByRole('region', { name: 'Seguimiento de la revisión', exact: true }); await expect(region).toBeVisible();
    for (const boton of ['Registrar emisión interna', 'Aceptar internamente', 'Revocar decisión interna', 'Rechazar internamente']) { await page.getByLabel('Motivo', { exact: true }).fill('Motivo técnico sintético · ' + boton); await page.getByLabel('Referencia', { exact: true }).fill('Acta de prueba ' + boton); await page.getByRole('button', { name: boton, exact: true }).click(); await expect(page.getByLabel('Motivo', { exact: true })).toHaveValue(''); }
    await expect(region.getByText('Rechazada internamente', { exact: true })).toBeVisible(); await expect(page.getByRole('region', { name: 'Historial de la revisión' }).getByRole('listitem')).toHaveCount(5); expect(errores).toEqual([]); await page.screenshot({ path: resolve(salida, '01-escritorio-historia-tecnico.png'), fullPage: true });
});
test('03 escritorio: conflicto conserva motivo y recarga sin perderlo', async ({ page, context }) => {
    await entrar(context); await page.goto(`/propuestas/seguimiento?propuesta=${f.grande[1]}`); const otra = await context.newPage(); await otra.goto(`/propuestas/seguimiento?propuesta=${f.grande[1]}`);
    for (const p of [page, otra]) { await p.getByLabel('Motivo', { exact: true }).fill(p === page ? 'Primera emisión' : 'Motivo que debe conservarse'); await p.getByLabel('Referencia', { exact: true }).fill('Acta conflicto'); }
    await page.getByRole('button', { name: 'Registrar emisión interna', exact: true }).click(); await expect(page.getByRole('button', { name: 'Aceptar internamente', exact: true })).toBeVisible(); await otra.getByRole('button', { name: 'Registrar emisión interna', exact: true }).click(); await expect(otra.getByRole('region', { name: 'Registrar decisión interna', exact: true }).getByRole('alert')).toContainText('cambió'); await expect(otra.getByRole('textbox', { name: 'Motivo', exact: true })).toHaveValue('Motivo que debe conservarse');
    await otra.getByRole('button', { name: 'Recargar y comparar conservando motivo' }).click(); await expect(otra.getByRole('button', { name: 'Aceptar internamente', exact: true })).toBeVisible(); await expect(otra.getByRole('textbox', { name: 'Motivo', exact: true })).toHaveValue('Motivo que debe conservarse'); await otra.screenshot({ path: resolve(salida, '02-escritorio-conflicto.png'), fullPage: true }); await otra.close();
});
test('04 escritorio: embudo58,etapas,página50+8 y revisiónhistórica', async ({ page, context }) => {
    await entrar(context); const p = filtros(f.grande), r = await context.request.get('/api/seguimiento-propuestas/embudo?' + p).then(r => r.json()); expect(r.denominador).toBe(58); p.set('token', r.token);
    await page.goto('/propuestas/seguimiento?' + p); const region = page.getByRole('region', { name: 'Embudo de propuestas' }); await expect(region.getByText('Denominador 58 propuestas', { exact: false })).toBeVisible(); await expect(region.getByRole('row')).toHaveCount(51); await page.getByRole('button', { name: 'Siguiente página', exact: true }).click(); await expect(region.getByRole('row')).toHaveCount(9);
    await region.getByRole('link', { name: /Rechazada internamente/ }).click(); await expect(region.getByRole('row')).toHaveCount(2); await expect(region.getByText('Denominador 58 propuestas', { exact: false })).toBeVisible(); await page.screenshot({ path: resolve(salida, '03-escritorio-embudo58.png'), fullPage: true });
    await page.goto(`/propuestas/seguimiento?propuesta=${f.b.id}`); await expect(page.getByRole('region', { name: 'Seguimiento de la revisión', exact: true }).getByText('Borrador', { exact: true })).toBeVisible(); await page.getByLabel('Revisión observada').selectOption(f.b.revisionId); await expect(page.getByRole('region', { name: 'Seguimiento de la revisión', exact: true }).getByText('Aceptada internamente', { exact: true })).toBeVisible(); await expect(page.getByText('Revisión histórica', { exact: false })).toBeVisible();
});
test('05 escritorio: monedas explícitas y privacidad HTML/RSC/API', async ({ page, context }) => {
    await entrar(context); await page.goto(`/propuestas/seguimiento?propuesta=${f.parcial.id}`); await page.getByLabel('Consultar base, impuesto y bruto por moneda').check(); await page.getByRole('button', { name: 'Consultar cohorte', exact: true }).click(); await expect(page.getByRole('heading', { name: 'Base propuesta sin impuestos por estado' })).toBeVisible(); await expect(page.getByRole('region', { name: 'Importes por estado' }).getByText('20,00 EUR', { exact: true })).toBeVisible(); await page.screenshot({ path: resolve(salida, '04-escritorio-parcial-monedas.png'), fullPage: true });
    await entrar(context, f.tecnico); await page.goto(`/propuestas/seguimiento?propuesta=${f.a.id}`); await expect(page.getByRole('region', { name: 'Seguimiento de la revisión', exact: true })).toBeVisible(); await expect(page.getByLabel('Consultar base, impuesto y bruto por moneda')).toHaveCount(0);
    const api = await context.request.get('/api/seguimiento-propuestas/embudo?' + filtros([f.a.id, f.parcial.id, f.bom.id])).then(r => r.text()), html = await page.content(), rsc = await context.request.get(`/propuestas/seguimiento?propuesta=${f.a.id}`, { headers: { RSC: '1' } }).then(r => r.text()); for (const texto of [api, html, rsc]) expect(texto).not.toMatch(/subtotalMinor|precioUnitario|costePrevisto|"valoracion"\s*:|tarifaU4/); await writeFile(resolve(salida, 'privacidad-tecnico.txt'), api + '\n' + html + '\n' + rsc);
});
test('06 escritorio: retirada ACL elimina dato y acciones; respuesta antigua no reponeotra selección', async ({ page, context }) => {
    const c = await conectarRevisiones(URL_REA_PRUEBA); try { await entrar(context, f.gestor); await page.goto(`/propuestas/seguimiento?propuesta=${f.parcial.id}`); await expect(page.getByRole('button', { name: 'Revocar decisión interna' })).toBeVisible(); await page.getByLabel('Motivo', { exact: true }).fill('Revocación con permiso retirado'); await page.getByLabel('Referencia', { exact: true }).fill('Acta retiro'); await c`update usuario_permisos set acceso='oculto' where usuario_id=${f.gestor} and seccion='compras'`; await page.getByRole('button', { name: 'Revocar decisión interna' }).click(); await expect(page.getByRole('region', { name: 'Seguimiento de la revisión', exact: true })).toHaveCount(0); await expect(page.getByLabel('Consultar base, impuesto y bruto por moneda')).toHaveCount(0); } finally { await c`update usuario_permisos set acceso='editar' where usuario_id=${f.gestor} and seccion='compras'`; await c.end(); }
});
test('06b escritorio: respuesta tardía de otra etapa no sustituye selección', async ({ page, context }) => {
    await entrar(context); const p = filtros(f.grande), b = await context.request.get('/api/seguimiento-propuestas/embudo?' + p).then(r => r.json()); p.set('token', b.token); await page.goto('/propuestas/seguimiento?' + p); const region = page.getByRole('region', { name: 'Embudo de propuestas' }); await expect(region.getByText('Denominador 58 propuestas', { exact: false })).toBeVisible();
    let liberar: () => void = () => {}, llegada: () => void = () => {}; const retenida = new Promise<void>(r => { liberar = r; }), recibida = new Promise<void>(r => { llegada = r; });
    await page.route('**/api/seguimiento-propuestas/embudo/detalle?**', async route => { if (new URL(route.request().url()).searchParams.get('etapa') === 'borrador') { const r = await route.fetch(); llegada(); await retenida; await route.fulfill({ response: r }).catch(() => {}); } else await route.continue(); });
    await region.getByRole('link', { name: /^Borrador/ }).click(); await recibida; await region.getByRole('link', { name: /Rechazada internamente/ }).click(); await expect(region.getByRole('row')).toHaveCount(2); liberar(); await page.waitForTimeout(250); await expect(region.getByRole('row')).toHaveCount(2); await expect(region.getByText('Rechazada internamente · 1 propuestas')).toBeVisible();
});
test('06c escritorio: POST tardío conserva propuesta elegida y evento anterior', async ({ page, context }) => {
    await entrar(context); const a = f.grande[10], b = f.grande[11], p = filtros([a, b]), conjunto = await context.request.get('/api/seguimiento-propuestas/embudo?' + p).then(r => r.json()); p.set('token', conjunto.token);
    await page.goto('/propuestas/seguimiento?' + p); const region = page.getByRole('region', { name: 'Seguimiento de la revisión', exact: true }); await expect(region).toBeVisible();
    const tituloB = await context.request.get('/api/seguimiento-propuestas/' + b).then(r => r.json()).then(d => d.revision.titulo);
    let liberar: () => void = () => {}, llegada: () => void = () => {}; const retenida = new Promise<void>(r => { liberar = r; }), recibida = new Promise<void>(r => { llegada = r; });
    await page.route('**/api/seguimiento-propuestas/' + a, async route => { if (route.request().method() !== 'POST') return route.continue(); const r = await route.fetch(); llegada(); await retenida; await route.fulfill({ response: r }); });
    await page.getByRole('textbox', { name: 'Motivo', exact: true }).fill('Decisión A retenida'); await page.getByRole('textbox', { name: 'Referencia', exact: true }).fill('Acta A'); await page.getByRole('button', { name: 'Registrar emisión interna', exact: true }).click(); await recibida;
    await page.getByRole('region', { name: 'Embudo de propuestas' }).getByRole('button', { name: tituloB, exact: true }).click(); await expect(region.getByRole('heading', { name: tituloB, exact: true })).toBeVisible(); await page.getByRole('textbox', { name: 'Motivo', exact: true }).fill('Edición B conservada'); liberar(); await page.waitForTimeout(400);
    await expect(region.getByRole('heading', { name: tituloB, exact: true })).toBeVisible(); await expect(page.getByRole('textbox', { name: 'Motivo', exact: true })).toHaveValue('Edición B conservada'); const anterior = await context.request.get('/api/seguimiento-propuestas/' + a).then(r => r.json()); expect(anterior.estado).toBe('emitida'); expect(anterior.eventos).toHaveLength(1);
});
test('06d HTTP: autorización actual precede a JSON y límite de cuerpo', async ({ context }) => {
    const c = await conectarRevisiones(URL_REA_PRUEBA); const previa = await c`select acceso from usuario_permisos where usuario_id=${f.gestor} and seccion='salas'`;
    try {
        await entrar(context, f.gestor); await c`insert into usuario_permisos(usuario_id,seccion,acceso) values(${f.gestor},'salas','oculto') on conflict(usuario_id,seccion) do update set acceso='oculto'`;
        for (const cuerpo of ['{', 'x'.repeat(65537)]) expect((await context.request.post('/api/seguimiento-propuestas/' + f.grande[12], { headers: { Origin: 'http://localhost:3118', 'Content-Type': 'application/json' }, data: cuerpo })).status()).toBe(403);
    } finally { if (previa.length) await c`update usuario_permisos set acceso=${previa[0].acceso} where usuario_id=${f.gestor} and seccion='salas'`; else await c`delete from usuario_permisos where usuario_id=${f.gestor} and seccion='salas'`; await c.end(); }
    await entrar(context); for (const [cuerpo, status] of [['{', 400], ['x'.repeat(65537), 413]] as const) expect((await context.request.post('/api/seguimiento-propuestas/' + f.grande[12], { headers: { Origin: 'http://localhost:3118', 'Content-Type': 'application/json' }, data: cuerpo })).status()).toBe(status);
});
test('07 móvil final yteclado, sin desbordamiento horizontal', async ({ page, context }) => {
