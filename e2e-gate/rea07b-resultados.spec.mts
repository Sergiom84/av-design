import {test,expect,type BrowserContext} from '@playwright/test';
import {readFile,writeFile,mkdir} from 'node:fs/promises';
import {resolve} from 'node:path';
import {conectarRevisiones,URL_REA_PRUEBA,fotografiarRevisiones,type SqlRevisionesPrueba} from '../scripts/rea07b-fixture.mjs';
import {COOKIE_SESION,firmarSesion} from '../src/lib/sesion';
const dir=resolve('output/rea-integracion/rea07b/resultados-runtime',process.env.REA07B_EVIDENCIA??'chrome-1'),fixture=JSON.parse(await readFile('output/rea-integracion/rea07b/resultados-runtime/navegador-fixture.json','utf8')),url=`/proyectos/${fixture.f.proyecto}/resultados?propuesta=${fixture.p.id}&revision=${fixture.p.revisionId}`,headers={Origin:'http://localhost:3121'};
let c:SqlRevisionesPrueba,foto:Awaited<ReturnType<typeof fotografiarRevisiones>>,idResultado='',guardado:unknown,body:unknown;
async function entrar(context:BrowserContext,id:string){await context.clearCookies();await context.addCookies([{name:COOKIE_SESION,value:await firmarSesion(fixture.secreto,Date.now()+3600000,id),domain:'localhost',path:'/',httpOnly:true,sameSite:'Lax'}]);}
async function conservar(nombre:string,v:unknown){await writeFile(resolve(dir,nombre),JSON.stringify(v,null,2));}
test.describe.serial('REA07B resultados financieros reales',()=>{
 test.beforeAll(async()=>{expect(process.env.REA07B_DATABASE_URL).toBe(URL_REA_PRUEBA);c=await conectarRevisiones(URL_REA_PRUEBA);await mkdir(dir,{recursive:true});foto=await fotografiarRevisiones(c);await conservar('antes.json',foto);});
 test.afterAll(async()=>{if(c){await c`update usuarios set rol='admin' where id=${fixture.admin}`;const despues=await fotografiarRevisiones(c);await conservar('despues.json',despues);for(const t of foto.tablas)if(!['propuesta_resultado_cortes','propuesta_seguimiento_operaciones'].includes(t.tabla))expect(despues.tablas.find(x=>x.tabla===t.tabla)?.sha256,t.tabla).toBe(t.sha256);await c.end();}});
 test('escritorio: revisión alcance→preview100/30/40→guardar30→reabrir durable',async({page,context})=>{
  await entrar(context,fixture.admin);await page.goto(url);await expect(page.getByRole('combobox',{name:'Propuesta',exact:true})).toHaveValue(fixture.p.id);await page.getByLabel('Identificador de un corte real REA05').fill(fixture.corte.id);await page.getByRole('button',{name:'Revisar corte de costes',exact:true}).click();await expect(page.getByRole('region',{name:'Cobertura del corte de costes'})).toContainText('Registros incluidos: 2. Pendientes: 0.');await page.getByRole('textbox',{name:'Declaración literal de cobertura',exact:true}).fill('REA07B revisión expresa: ambas fuentes, salas y período del alcance registrado. No afirma trabajo no registrado.');await page.getByLabel('He revisado que el período cubre todo el alcance aprobado').check();await page.getByRole('textbox',{name:'Motivo del corte',exact:true}).fill('REA07B navegador resultado completo');await page.getByRole('button',{name:'Preparar resultado',exact:true}).click();const resultado=page.getByRole('region',{name:'Resultado preparado'});await expect(resultado.getByRole('heading',{name:'Comparable sobre registros conciliados',exact:true})).toBeVisible();await expect(resultado.getByRole('row').last()).toContainText('100,00 EUR');await expect(resultado.getByRole('row').last()).toContainText('70,00 EUR');await expect(resultado.getByRole('row').last()).toContainText('30,00 EUR');await page.screenshot({path:resolve(dir,'01-escritorio-comparable.png'),fullPage:true});
  page.on('request',r=>{if(r.method()==='POST'&&r.url().endsWith('/api/resultados-propuestas'))body=r.postDataJSON();});const respuesta=page.waitForResponse(r=>r.request().method()==='POST'&&r.url().endsWith('/api/resultados-propuestas'));await page.getByRole('button',{name:'Confirmar y conservar corte',exact:true}).click();const res=await respuesta;expect(res.status()).toBe(201);idResultado=(await res.json()).id;await expect(page.getByText('Resultado conservado.',{exact:true})).toBeVisible();const api=await context.request.get('/api/resultados-propuestas/'+idResultado);expect(api.status()).toBe(200);guardado=await api.json();await conservar('guardado-http-antes.json',guardado);await conservar('confirmacion-body.json',body);await page.reload();await expect(page.getByRole('heading',{name:'Resultados conservados',exact:true})).toBeVisible();await page.getByRole('button',{name:/^Corte /}).first().click();await expect(page.getByText(new RegExp('Resultado '+idResultado))).toBeVisible();await expect(page.getByText('Referencias vigentes en esta consulta',{exact:false})).toBeVisible();await page.screenshot({path:resolve(dir,'02-escritorio-reabierto.png'),fullPage:true});
 });
 test('escritorio: parcial no resta,409 conserva motivo y respuesta tardía no cambia selección',async({page,context})=>{
  await entrar(context,fixture.admin);await page.goto(url);await page.getByLabel('Identificador de un corte real REA05').fill(fixture.corte.id);await page.getByRole('button',{name:'Revisar corte de costes',exact:true}).click();await expect(page.getByRole('heading',{name:'Revisión expresa del alcance'})).toBeVisible();await page.getByRole('textbox',{name:'Declaración literal de cobertura',exact:true}).fill('REA07B período parcial, declaración literal conservada');await page.getByRole('textbox',{name:'Motivo del corte',exact:true}).fill('BORRADOR REA07B CONSERVAR409');await page.getByRole('button',{name:'Preparar resultado',exact:true}).click();const resultado=page.getByRole('region',{name:'Resultado preparado'});await expect(resultado.getByRole('heading',{name:'Parcial',exact:true})).toBeVisible();await expect(resultado.getByRole('row').last()).toContainText('Sin datos');await page.route('**/api/resultados-propuestas',async ruta=>{if(ruta.request().method()!=='POST')return ruta.continue();const b=ruta.request().postDataJSON();const real=await ruta.fetch({postData:JSON.stringify({...b,seleccion:{...b.seleccion,versionPropuesta:b.seleccion.versionPropuesta+1}})});expect(real.status()).toBe(409);await ruta.fulfill({response:real});});await page.getByRole('button',{name:'Confirmar y conservar corte',exact:true}).click();await expect(page.getByRole('alert').filter({hasText:'cambió'})).toContainText('cambió');await expect(page.getByRole('textbox',{name:'Motivo del corte',exact:true})).toHaveValue('BORRADOR REA07B CONSERVAR409');await expect(page.getByRole('textbox',{name:'Declaración literal de cobertura',exact:true})).toHaveValue('REA07B período parcial, declaración literal conservada');await page.screenshot({path:resolve(dir,'03-escritorio-parcial409.png'),fullPage:true});await page.unroute('**/api/resultados-propuestas');
  let liberar!:()=>void,llego!:()=>void;const espera=new Promise<void>(r=>liberar=r),recibida=new Promise<void>(r=>llego=r);await page.route('**/api/resultados-propuestas?*',async ruta=>{const r=await ruta.fetch();llego();await espera;await ruta.fulfill({response:r});});await page.getByRole('button',{name:'Revisar corte de costes',exact:true}).click();await recibida;await page.getByLabel('Identificador de un corte real REA05').fill('00000000-0000-4000-8000-000000000099');liberar();await expect(page.getByLabel('Identificador de un corte real REA05')).toHaveValue('00000000-0000-4000-8000-000000000099');await expect(page.getByRole('region',{name:'Resultado preparado'})).toHaveCount(0);await expect(page.getByRole('region',{name:'Cobertura del corte de costes'})).toHaveCount(0);await page.screenshot({path:resolve(dir,'04-tardia-seleccion-conservada.png'),fullPage:true});
 });
 test('privacidad API/HTML/RSC y revocación con cookie válida; móvil sólo tras escritorio',async({page,context})=>{
  const privado=/baseAprobadaMinor|costeRegistradoMinor|diferenciaMinor|"tratamientoFiscal"|REA07B revisión expresa/;
  for(const usuario of[fixture.lector,fixture.gestor]){await entrar(context,usuario);for(const ruta of['/api/resultados-propuestas/'+idResultado,`/api/resultados-propuestas?proyecto=${fixture.f.proyecto}&propuesta=${fixture.p.id}`]){const r=await context.request.get(ruta);expect(r.status()).toBe(403);expect(await r.text()).not.toMatch(privado);}for(const rsc of[false,true]){const r=await context.request.get(url,{headers:rsc?{RSC:'1','Next-Router-Prefetch':'1'}:{}}),b=await r.text();expect(b).not.toMatch(privado);await writeFile(resolve(dir,`privacidad-${usuario}-${rsc?'rsc':'html'}.txt`),b);}await page.goto(url);await expect(page.getByRole('alert').filter({hasText:'permiso'})).toContainText('permiso');await page.screenshot({path:resolve(dir,`05-privacidad-${usuario}.png`),fullPage:true});}
  await entrar(context,fixture.admin);await c`update usuarios set rol='lectura' where id=${fixture.admin}`;for(const ruta of['/api/resultados-propuestas/'+idResultado])expect((await context.request.get(ruta)).status()).toBe(403);const replay=await context.request.post('/api/resultados-propuestas',{headers,data:body});expect(replay.status()).toBe(403);await page.goto(url);await expect(page.getByRole('alert').filter({hasText:'permiso'})).toContainText('permiso');await c`update usuarios set rol='admin' where id=${fixture.admin}`;
  await page.setViewportSize({width:390,height:844});await page.goto(url);await page.getByLabel('Identificador de un corte real REA05').fill(fixture.corte.id);await page.getByRole('button',{name:'Revisar corte de costes',exact:true}).click();await expect(page.getByRole('region',{name:'Cobertura del corte de costes'})).toBeVisible();await page.getByRole('textbox',{name:'Declaración literal de cobertura',exact:true}).fill('REA07B cierre móvil tras escritorio');await page.getByRole('textbox',{name:'Motivo del corte',exact:true}).fill('Motivo móvil');await page.getByLabel('He revisado que el período cubre todo el alcance aprobado').check();await page.getByRole('button',{name:'Preparar resultado',exact:true}).click();await expect(page.getByRole('heading',{name:'Comparable sobre registros conciliados',exact:true})).toBeVisible();expect(await page.evaluate(()=>document.documentElement.scrollWidth<=innerWidth)).toBeTruthy();await page.getByRole('textbox',{name:'Motivo del corte',exact:true}).focus();await page.keyboard.press('Tab');await expect(page.getByRole('button',{name:'Preparar resultado',exact:true})).toBeFocused();await page.screenshot({path:resolve(dir,'06-movil-teclado.png'),fullPage:true});await conservar('durabilidad.json',{idResultado,guardado,usuario:fixture.admin});
 });
});
