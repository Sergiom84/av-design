 test('04 retirada RSC durante GET suspendido no repone contenido',async({page,context})=>{
  const usuario=idServicio(3),previos=await sql`select seccion,acceso from usuario_permisos where usuario_id=${usuario}`;await sql`insert into usuario_permisos(usuario_id,seccion,acceso) values(${usuario},'salas','editar'),(${usuario},'proyectos','oculto'),(${usuario},'catalogo','oculto') on conflict(usuario_id,seccion) do update set acceso=excluded.acceso`;await entrar(context,usuario);await page.goto(`/salas/${F.sala}/servicio`);await expect(page.getByRole('button',{name:/^Fallo de imagen Chrome sintético/}).first()).toBeVisible();let liberar!:()=>void,tomada!:()=>void;const pausa=new Promise<void>(r=>liberar=r),capturada=new Promise<void>(r=>tomada=r);
  await page.route('**/api/servicio-instalaciones?salaId=*',async route=>{const response=await route.fetch();tomada();await pausa;await route.fulfill({response});});try{await page.getByRole('button',{name:'Recargar y comparar',exact:true}).click();await capturada;await sql`update usuario_permisos set acceso='oculto' where usuario_id=${usuario} and seccion='salas'`;await page.getByRole('button',{name:'Actualizar acceso y contexto',exact:true}).click();await expect(page.getByRole('button',{name:/^Fallo de imagen Chrome sintético/})).toHaveCount(0);liberar();await expect(page.getByRole('button',{name:/^Fallo de imagen Chrome sintético/})).toHaveCount(0);await page.screenshot({path:`${salida}/escritorio-retirada-rsc.png`,fullPage:true});}finally{liberar();await sql`delete from usuario_permisos where usuario_id=${usuario}`;for(const p of previos)await sql`insert into usuario_permisos(usuario_id,seccion,acceso) values(${usuario},${p.seccion},${p.acceso})`;}
 });
