} catch (e) {
    await page.screenshot({ path: join(salida, 'fallo.png'), fullPage: true });
    await guardar('fallo.json', { error: String(e), html: await page.content(), errores, externas });
    throw e;
} finally {
    await browser.close();
    await sql`delete from consultas_conversaciones where propietario_id=${u}`;
    await sql`delete from preferencias_usuario where usuario_id=${u}`;
    await sql`delete from usuario_permisos where usuario_id=${u}`;
    await sql`delete from salas where id=${sala}`;
    await sql`delete from articulos_tecnicos where articulo_id=${articulo}`;
    await sql`delete from articulos where id in ${sql([articulo, material])}`;
    await sql`delete from usuarios where id=${u}`;
    const despues = await fotografiarBase(sql), ajenas = (f: typeof antes) => f.tablas.filter(t => !t.tabla.startsWith('consultas_'));
    const iguales = JSON.stringify(ajenas(antes)) === JSON.stringify(ajenas(despues));
    await guardar('resultado.json', { identidad: real, navegador: browser.version(), ok, errores, externas, tablasAjenas: ajenas(antes).length, ajenasIguales: iguales, antes, despues });
    await sql.end(); assert(iguales, 'Tablas ajenas idénticas después del recorrido focal.');
