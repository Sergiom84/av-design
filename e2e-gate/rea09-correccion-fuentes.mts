    await sql`insert into salas(id,nombre,largo_m,ancho_m,alto_m) values(${sala},'REA09 UI BOM propia',6,4,3)`;
    await sql`insert into articulos(id,referencia,tipo,categoria,marca,modelo,unidad,descripcion,fuente) values(${articulo},${'UI-' + articulo},'equipo','PANTALLA',${marca},${modelo},'ud','Ficha técnica de prueba UI','app'),(${material},${'UI-' + material},'consumible','FIJACIÓN',${marca},'Fijación UI09','ud','Partida BOM propia UI','app')`;
    await sql`insert into sala_material_bom(id,sala_id,articulo_id,cantidad,unidad,nota) values(${bom},${sala},${material},3,'ud','Fuente que se retirará')`;
    await sql`insert into preferencias_usuario(usuario_id,version,catalogo) values(${u},1,${sql.json({ marcas: [marca], q: '' })})`;
