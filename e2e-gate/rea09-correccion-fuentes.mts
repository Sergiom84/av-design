const modulo = Module as unknown as { _load: (id: string, ...args: unknown[]) => unknown }, cargar = modulo._load;
modulo._load = (id, ...args) => id === 'server-only' ? {} : cargar.call(Module, id, ...args);
const { fotografiarBase } = await import('../scripts/documentos-fixture.mjs');
assert.equal(process.env.REA09_DATABASE_URL, 'postgres://av_design_rea09:av_design_rea09_local@127.0.0.1:5562/av_design_rea09_prueba');
assert(process.env.REA09_SALIDA, 'Salida nueva explícita obligatoria.');
const salida = resolve(process.env.REA09_SALIDA), base = 'http://localhost:3120';
await mkdir(salida, { recursive: true });
const guardar = (nombre: string, valor: unknown) => writeFile(join(salida, nombre), JSON.stringify(valor, null, 2), { flag: 'wx' });
const sql = postgres(process.env.REA09_DATABASE_URL, { max: 5, ssl: false, onnotice: () => {} });
const [real] = await sql`select current_database() base,current_user usuario,inet_server_port() puerto`;
assert.deepEqual(real, { base: 'av_design_rea09_prueba', usuario: 'av_design_rea09', puerto: 5432 });
const antes = await fotografiarBase(sql), u = randomUUID(), articulo = randomUUID(), material = randomUUID(), sala = randomUUID(), bom = randomUUID(), marca = 'REA09 UI CORRECCION ' + Date.now(), modelo = 'Ficha exacta UI09';
const browser = await chromium.launch({ channel: 'chrome', headless: true }), contexto = await browser.newContext({ viewport: { width: 1440, height: 1000 } }), page = await contexto.newPage();
const errores: string[] = [], externas: string[] = [], ok: string[] = [];
page.on('pageerror', e => errores.push(e.message));
page.on('request', r => { if (!r.url().startsWith(base) && !r.url().startsWith('data:')) externas.push(r.url()); });
const paso = (s: string) => { ok.push(s); console.log('OK', s); };
const crear = async () => { const espera = page.waitForResponse(r => r.url() === base + '/api/consultas' && r.request().method() === 'POST'); await page.getByRole('button', { name: 'Empezar consulta', exact: true }).click(); const res = await espera; assert.equal(res.status(), 200); await expect(page.getByLabel('Pregunta', { exact: true })).toBeVisible(); };
const preguntar = async (texto: string) => { await page.getByLabel('Pregunta', { exact: true }).fill(texto); const espera = page.waitForResponse(r => r.url().endsWith('/turnos') && r.request().method() === 'POST'); await page.getByRole('button', { name: 'Consultar', exact: true }).click(); const res = await espera; assert.equal(res.status(), 200, await res.text()); await expect(page.getByRole('heading', { name: 'Respuesta y fuentes', exact: true })).toBeVisible(); };
const consultarFicha = async () => { await page.getByRole('combobox').first().selectOption('catalogo'); await crear(); await preguntar('Buscar catálogo'); await page.getByLabel('Ficha exacta del resultado').selectOption(articulo); await preguntar('Ficha de catálogo'); await expect(page.getByRole('cell', { name: '530 mm', exact: true })).toBeVisible(); await expect(page.getByRole('cell', { name: '310 mm', exact: true })).toBeVisible(); await expect(page.getByRole('cell', { name: '80 mm', exact: true })).toBeVisible(); await expect(page.getByRole('cell', { name: 'Fabricante corrección UI09', exact: true })).toBeVisible(); await expect(page.getByRole('cell', { name: '2026-10-15', exact: true })).toBeVisible(); };
