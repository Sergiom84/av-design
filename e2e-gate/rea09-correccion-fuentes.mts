    await expect(page.getByRole('cell', { name: '3 ud', exact: true })).toBeVisible();
    await sql`delete from sala_material_bom where id=${bom}`;
    await page.getByRole('button', { name: 'Turno 1 · necesidad', exact: true }).click();
    await expect(page.getByText('Este turno ya no está disponible con las fuentes y permisos actuales.', { exact: true })).toBeVisible();
    await expect(page.getByRole('cell', { name: '3 ud', exact: true })).toHaveCount(0);
    await page.screenshot({ path: join(salida, '03-desktop-bom-retirada.png'), fullPage: true });
    paso('Escritorio: fila BOM eliminada bloquea turno completo sin partida anterior');
    await sql`update articulos set activo=true where id=${articulo}`;
    await page.setViewportSize({ width: 390, height: 844 }); await page.goto(base + '/cuenta/consultas'); await consultarFicha();
    const geometria = await page.evaluate(() => ({ anchoDocumento: document.documentElement.scrollWidth, anchoVentana: innerWidth }));
    await guardar('geometria-movil.json', geometria);
    assert(geometria.anchoDocumento <= geometria.anchoVentana + 1);
    await page.screenshot({ path: join(salida, '04-movil-ficha.png'), fullPage: true });
    paso('Móvil al final: ficha exacta legible, teclado y sin overflow horizontal');
