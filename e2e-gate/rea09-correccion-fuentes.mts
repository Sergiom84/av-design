    await page.goto(base + '/cuenta/consultas'); await consultarFicha();
    await expect(page.getByRole('cell', { name: /^2026-10-16T/ })).toBeVisible();
    await page.getByText('Procedencia de la captura', { exact: true }).click();
    await expect(page.getByText(/Proyección SHA-256/)).toHaveCount(2);
    assert.equal(await page.locator('a[href^="https://example.invalid"]').count(), 0);
    await page.screenshot({ path: join(salida, '01-desktop-ficha.png'), fullPage: true });
    paso('Escritorio: ficha exacta con dimensiones, unidad, origen, fechas, hash y URL literal');
    await sql`update articulos set activo=false where id=${articulo}`;
    await page.getByRole('button', { name: 'Turno 2 · catalogo', exact: true }).click();
    await expect(page.getByText('Este turno ya no está disponible con las fuentes y permisos actuales.', { exact: true })).toBeVisible();
    await expect(page.getByRole('cell', { name: '530 mm', exact: true })).toHaveCount(0);
    await expect(page.getByRole('cell', { name: 'Fabricante corrección UI09', exact: true })).toHaveCount(0);
    await page.screenshot({ path: join(salida, '02-desktop-catalogo-retirado.png'), fullPage: true });
    paso('Escritorio: catálogo retirado sustituye respuesta/citas por placeholder completo');
