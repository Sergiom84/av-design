    assert.equal(retiro.status(), 200, await retiro.text());
    await page.getByRole('button', { name: 'Turno 1 · documentos', exact: true }).click();
    await expect(page.getByText('Este turno ya no está disponible con las fuentes y permisos actuales.', { exact: true })).toBeVisible();
    await expect(page.getByRole('cell', { name: h.valor, exact: true })).toHaveCount(0);
    await expect(page.getByText(`Fragmento SHA-256 ${h.anclaDocumento.sha256}`, { exact: true })).toHaveCount(0);
    await page.screenshot({ path: resolve(salida, '03-movil-fuente-retirada.png'), fullPage: true });
    paso('Retirada real10 bloquea turno09 completo y retira texto/cita del DOM');
    assert.deepEqual(errores, []); assert.deepEqual(externas, []);
    await writeFile(resolve(salida, 'resultado.json'), JSON.stringify({ pasos, errores, externas, envios, enlace, conversacionId: conversacion.id, turnoId: respuesta.id, navegador: browser.version(), estado: 'VERDE', limite: 'Fixture sintética propia; no aceptación global ni voz real.' }, null, 2), { flag: 'wx' });
} catch (error) {
    await page.screenshot({ path: resolve(salida, 'fallo.png'), fullPage: true });
    await writeFile(resolve(salida, 'fallo.json'), JSON.stringify({ mensaje: String(error), pasos, errores, externas, envios, html: await page.content() }, null, 2), { flag: 'wx' }); throw error;
} finally { await browser.close(); }
