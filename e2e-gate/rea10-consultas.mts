/** Flujo real10→09, exclusivamente copia QA y fixture sintética5565. */
import assert from 'node:assert/strict';
import { mkdir, readFile, writeFile } from 'node:fs/promises';
import { resolve } from 'node:path';
import { chromium, expect } from '@playwright/test';
import { COOKIE_SESION, firmarSesion } from '../src/lib/sesion';
const base = 'http://localhost:3124';
assert.equal(process.env.REA10_CONSULTAS_DATABASE_URL, 'postgres://av_design_rea10_puente:av_design_rea10_puente_local@127.0.0.1:5565/av_design_rea10_puente_prueba');
assert.ok(process.env.REA10_CONSULTAS_FIXTURE && process.env.REA10_CONSULTAS_SALIDA);
const f = JSON.parse(await readFile(resolve(process.env.REA10_CONSULTAS_FIXTURE), 'utf8'));
const salida = resolve(process.env.REA10_CONSULTAS_SALIDA);
await mkdir(salida, { recursive: false });
const browser = await chromium.launch({ channel: 'chrome', headless: true });
const context = await browser.newContext({ viewport: { width: 1440, height: 1000 } });
await context.addCookies([{ name: COOKIE_SESION, value: await firmarSesion('rea10-puente-consultas-local-sintetico-2026', Date.now() + 3600_000, f.usuarioId), url: base, httpOnly: true, sameSite: 'Lax' }]);
const page = await context.newPage(); page.setDefaultTimeout(30000);
const errores: string[] = [], externas: string[] = [], envios: string[] = [], pasos: string[] = [];
page.on('pageerror', e => errores.push(e.message));
page.on('request', r => { if (!r.url().startsWith(base) && !/^(data:|blob:)/.test(r.url())) externas.push(r.url()); if (r.method() === 'POST' && r.url().includes('/api/consultas')) envios.push(r.url()); });
const paso = (s: string) => { pasos.push(s); console.log(s); };
try {
    await page.goto(base + f.href);
    await expect(page.getByRole('button', { name: 'Descargar original', exact: true })).toBeVisible({ timeout: 30000 });
    await page.getByRole('button', { name: 'Abrir plan', exact: true }).click();
    await expect(page.getByText('0 de 20 fragmentos elegidos', { exact: true })).toBeVisible();
    await expect(page.getByRole('link', { name: 'Consultar fragmentos elegidos', exact: true })).toHaveCount(0);
    await page.locator(`input[data-candidato-consulta="${f.candidatoId}"]`).check();
    const enlace = await page.getByRole('link', { name: 'Consultar fragmentos elegidos', exact: true }).getAttribute('href');
    await page.getByRole('link', { name: 'Consultar fragmentos elegidos', exact: true }).click();
    await expect(page.getByRole('heading', { name: 'Elegir ámbito', exact: true })).toBeVisible();
    assert.deepEqual(envios, []);
    await expect(page.getByRole('button', { name: 'Empezar consulta', exact: true })).toBeDisabled();
    paso('Escritorio: fragmento revisado elegido en10;09 abre sin salas, conversación ni pregunta automáticas');
    const opciones = await (await context.request.get(`${base}/api/consultas/opciones?tipo=obra&id=${f.proyectoId}&q=&pagina=0`)).json();
    const sala = opciones.opciones.find((s: { id: string }) => s.id === f.salaId); assert.ok(sala);
    await page.getByRole('checkbox', { name: `${sala.nombre}${sala.codigo ? ` · ${sala.codigo}` : ''}`, exact: true }).check();
    const crear = page.waitForResponse(r => r.request().method() === 'POST' && r.url() === base + '/api/consultas');
    await page.getByRole('button', { name: 'Empezar consulta', exact: true }).click();
    const crearHttp = await crear, conversacion = await crearHttp.json();
    await writeFile(resolve(salida, 'crear-http.json'), JSON.stringify({ status: crearHttp.status(), headers: await crearHttp.request().allHeaders(), body: conversacion }, null, 2), { flag: 'wx' });
    assert.equal(crearHttp.status(), 200, JSON.stringify(conversacion)); assert.ok(conversacion.id);
    await expect(page.getByLabel('Pregunta', { exact: true })).toHaveValue('Consultar documentos seleccionados');
    assert.equal(envios.length, 1);
    const preguntar = page.waitForResponse(r => r.request().method() === 'POST' && r.url() === `${base}/api/consultas/${conversacion.id}/turnos`);
    await page.getByRole('button', { name: 'Consultar', exact: true }).click();
    const http = await preguntar, respuesta = await http.json(); assert.equal(http.status(), 200, JSON.stringify(respuesta));
    assert.equal(respuesta.respuesta.hechos.length, 1); const h = respuesta.respuesta.hechos[0];
    assert.equal(h.anclaDocumento.documentoId, f.documentoId); assert.equal(h.anclaDocumento.extraccionId, f.extraccionId); assert.match(h.anclaDocumento.sha256, /^[a-f0-9]{64}$/);
    await expect(page.getByRole('cell', { name: h.valor, exact: true })).toBeVisible();
    await expect(page.getByText(`Fragmento SHA-256 ${h.anclaDocumento.sha256}`, { exact: true })).toBeVisible();
    await page.screenshot({ path: resolve(salida, '01-escritorio-respuesta.png'), fullPage: true });
    await writeFile(resolve(salida, 'respuesta.json'), JSON.stringify(respuesta, null, 2), { flag: 'wx' });
    paso('Selección explícita de sala, creación y envío manuales; un solo fragmento literal con línea/método/offsets/hash');
    await page.reload();
    const historial = await (await context.request.get(`${base}/api/consultas`)).json();
    const indice = historial.conversaciones.findIndex((c: { id: string }) => c.id === conversacion.id); assert.ok(indice >= 0);
    await page.getByRole('button', { name: new RegExp(`^Conversación ${indice + 1}\\s`) }).click();
    await page.getByRole('button', { name: 'Turno 1 · documentos', exact: true }).click();
    await expect(page.getByRole('cell', { name: h.valor, exact: true })).toBeVisible();
    paso('Recarga de aplicación e historial recuperan la captura autorizada');
    await page.setViewportSize({ width: 390, height: 844 });
    await page.getByLabel('Pregunta', { exact: true }).focus(); await page.keyboard.type('Consulta conservada por teclado'); await page.keyboard.press('Tab');
    assert.ok(await page.evaluate(() => document.documentElement.scrollWidth <= innerWidth + 1));
    await page.screenshot({ path: resolve(salida, '02-movil-respuesta-teclado.png'), fullPage: true });
    paso('Móvil al final: respuesta/cita legibles, teclado y tabulación,390sin desbordamiento');
