{
  "name": "av-design",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --import tsx --test \"src/lib/*.test.ts\" \"src/pruebas/*.test.ts\" \"src/components/**/*.test.ts\" \"src/components/**/*.test.tsx\" \"scripts/*.test.mjs\"",
    "typecheck": "tsc --noEmit",
    "seed": "node scripts/generar-seed.mjs",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "node scripts/db.mjs db/schema.sql",
    "db:seed": "node scripts/db.mjs db/seed.sql",
    "db:reset": "npm run db:up && npm run db:migrate && npm run db:seed",
    "catalogo:normalizar": "node scripts/normalizar-catalogo.mjs",
    "migrar:sillas": "tsx scripts/migrar-sillas.mts",
    "usuarios:admin": "tsx scripts/crear-admin.mts",
    "test:guardas-sala": "tsx scripts/verificar-guarda-equipos.mts",
    "test:diagrama": "tsx scripts/verificar-diagrama.mts",
    "test:rutas-cable": "tsx scripts/verificar-rutas-cable.mts",
    "test:concurrencia": "tsx scripts/verificar-concurrencia.mts",
    "test:bocas": "tsx scripts/verificar-bocas-puerto.mts",
    "test:editor-conexiones": "tsx scripts/verificar-editor-conexiones.mts",
    "test:mutaciones:bocas": "node scripts/verificar-mutaciones-bocas.mjs",
    "test:plantillas": "tsx scripts/verificar-plantillas.mts",
    "test:migracion": "tsx scripts/verificar-migracion-rol.mts",
    "test:backfill-sillas": "tsx scripts/verificar-backfill-sillas.mts",
    "test:usuarios": "tsx scripts/verificar-usuarios.mts",
    "test:e2e:diagrama": "node scripts/ejecutar-e2e-diagrama.mjs",
    "test:mutaciones-aislamiento": "node scripts/verificar-aislamiento-mutaciones.mjs"
  },
  "dependencies": {
    "next": "16.3.0",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.7",
    "typescript": "^5"
  }
}
