import {createHash} from 'node:crypto';
import {readdir,readFile,writeFile,stat} from 'node:fs/promises';
import {resolve,relative,dirname,join} from 'node:path';
import ts from 'typescript';
const raiz=process.cwd(),salida=resolve('output/rea-integracion/rea07b/resultados-runtime');
async function listar(p:string):Promise<string[]>{return (await stat(p)).isDirectory()?(await Promise.all((await readdir(p)).sort().map(n=>listar(join(p,n))))).flat():[p];}
const propios=(await Promise.all(['src/lib/resultados-propuestas','src/components/resultados-propuestas','src/app/api/resultados-propuestas','src/app/proyectos/[id]/resultados'].map(p=>listar(resolve(p))))).flat();
for(const p of ['src/lib','scripts','e2e-gate'])for(const n of await readdir(p))if(n!=='rea07b-fixture.mts'&&(p==='src/lib'?/^resultados-propuestas-.*\.test\.ts$/.test(n):/^(rea07b-|verificar-rea07b)/.test(n)))propios.push(resolve(p,n));
const vistos=new Set<string>(),dependencias=new Set<string>();async function visitar(p:string){if(vistos.has(p))return;vistos.add(p);const s=await readFile(p,'utf8'),info=ts.preProcessFile(s,true,true);for(const i of info.importedFiles){const nombre=i.fileName;if(!nombre.startsWith('.')&&!nombre.startsWith('@/'))continue;const base=nombre.startsWith('@/')?resolve(raiz,'src',nombre.slice(2)):resolve(dirname(p),nombre);let encontrado='';for(const candidato of [base,base.replace(/\.mjs$/,'.mts'),base+'.ts',base+'.tsx',base+'.mts',base+'/index.ts']){try{if((await stat(candidato)).isFile()){encontrado=candidato;break;}}catch{}}if(encontrado){if(!propios.includes(encontrado))dependencias.add(encontrado);await visitar(encontrado);}}}
for(const p of propios)await visitar(p);for(const p of ['scripts/rea07b-fixture.mts','src/lib/db-pool.test.ts','src/lib/seguimiento-propuestas/servicio.ts','src/lib/seguimiento-propuestas/enlaces-resultados.ts','src/components/seguimiento-propuestas/seguimiento.tsx','src/app/proyectos/[id]/page.tsx','src/lib/preferencias-usuario.ts','src/lib/panel-repositorio.ts','src/components/panel/resumen-panel.tsx','src/lib/db.ts','docs/25-rea07-especificacion.md','docs/23-rea05-especificacion.md','docs/24-rea06-especificacion.md','db/schema.sql','db/migraciones/2026-10-rea07-seguimiento.sql','package.json','package-lock.json','next.config.ts','tsconfig.json'])dependencias.add(resolve(p));
const filas=async(ps:Iterable<string>)=>Promise.all([...ps].sort().map(async p=>({ruta:relative(raiz,p),sha256:createHash('sha256').update(await readFile(p)).digest('hex')})));
const manifest={creadoEn:new Date().toISOString(),propios:await filas(propios),dependencias:await filas(dependencias)};const nombre=resolve(salida,'fuentes-'+Date.now()+'.json');await writeFile(nombre,JSON.stringify(manifest,null,2));await writeFile(resolve(salida,'fuentes-actual.json'),JSON.stringify({manifiesto:nombre},null,2));console.log(JSON.stringify({manifiesto:nombre,propios:manifest.propios.length,dependencias:manifest.dependencias.length,hash:createHash('sha256').update(JSON.stringify(manifest)).digest('hex')}));
