import {cp,mkdir,readFile,readdir,stat,symlink,writeFile} from 'node:fs/promises';
import {createHash,randomUUID} from 'node:crypto';
import {resolve,relative,join} from 'node:path';
const origen=process.cwd(),marca=Date.now(),destino=resolve('/private/tmp','av-design-rea07b-qa-'+marca+'-'+randomUUID().slice(0,8)),entradas=['src','public','package.json','package-lock.json','next.config.ts','postcss.config.mjs','tsconfig.json','next-env.d.ts'];await mkdir(destino,{recursive:true});
const archivos:Array<{ruta:string;sha256:string}>=[];async function listar(ruta:string):Promise<string[]>{return (await stat(ruta)).isDirectory()?(await Promise.all((await readdir(ruta)).sort().map(n=>listar(join(ruta,n))))).flat():[ruta];}
for(const entrada of entradas){const fuente=resolve(origen,entrada);await cp(fuente,resolve(destino,entrada),{recursive:true});for(const archivo of await listar(fuente)){const ruta=relative(origen,archivo),a=await readFile(archivo),b=await readFile(resolve(destino,ruta)),sha256=createHash('sha256').update(a).digest('hex');if(!a.equals(b))throw new Error('Fuente cambió en copia: '+ruta);archivos.push({ruta,sha256});}}
for(const a of archivos)if(createHash('sha256').update(await readFile(resolve(origen,a.ruta))).digest('hex')!==a.sha256)throw new Error('Fuente cambió en verificación: '+a.ruta);
await symlink(resolve(origen,'node_modules'),resolve(destino,'node_modules'),'dir');const salida=resolve(origen,'output/rea-integracion/rea07b/resultados-runtime'),manifiesto=resolve(salida,'snapshot-qa-'+marca+'.json');await writeFile(manifiesto,JSON.stringify({origen,destino,marca,archivos,exclusiones:['.env*','data','docs','output','.git'],dependencias:'node_modules enlazado sin instalar'},null,2));await writeFile(resolve(salida,'snapshot-qa-actual.json'),JSON.stringify({destino,manifiesto},null,2));console.log(JSON.stringify({destino,manifiesto,archivos:archivos.length}));
