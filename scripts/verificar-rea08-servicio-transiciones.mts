 await fail(()=>repo.ejecutar(F.autor,trans('cerrar',null)),422);ticket=await repo.ejecutar(F.autor,trans('atender','09:30')) as typeof activo;await fail(()=>repo.ejecutar(F.autor,trans('resolver','09:20')),422);ticket=await repo.ejecutar(F.autor,trans('resolver','10:00')) as typeof activo;ticket=await repo.ejecutar(F.autor,trans('cerrar',null)) as typeof activo;
 const inicial=(await repo.listar(F.autor,{salaId:F.sala,registroId:ticket.id})).registros[0].datos.slaInicial;ticket=await repo.ejecutar(F.autor,trans('reabrir',null)) as typeof activo;ticket=await repo.ejecutar(F.autor,trans('atender','11:00')) as typeof activo;ticket=await repo.ejecutar(F.autor,trans('resolver','12:00')) as typeof activo;
 const actual=(await repo.listar(F.autor,{salaId:F.sala,registroId:ticket.id})).registros[0];assert.deepEqual(actual.datos.slaInicial,inicial);assert.equal(actual.datos.atencion,'2026-10-15T07:30:00.000Z');checks.push('Atención/resolución/cierre yreapertura conservan SLAinicial sinreinicio');
