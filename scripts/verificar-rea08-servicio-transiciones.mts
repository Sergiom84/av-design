 const visita=await repo.ejecutar(F.autor,c('visita',{incidencia:b(ticket),datos:{...visitaDatos,motivoInactivo:'Registro atrasado real del técnico que ya causó baja'}})) as typeof activo;
 await repo.ejecutar(F.autor,c('corregir_visita',{base:b(visita),datos:{...visitaDatos,motivoInactivo:'Registro atrasado comprobado',anulada:true}}));checks.push('Visita técnico inactivo sóloconmotivo;anulación conserva2versiones');
 const historia=await repo.listar(F.autor,{salaId:F.sala,registroId:ticket.id,historial:true});assert(historia.historia.length>=8);checks.push('Historia deeventos consultable sinborrados');
