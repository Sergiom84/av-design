 const vista=await repo.listar(F.autor,{salaId:F.sala});const inc=vista.registros.find(r=>r.id===ticket.id)!;assert.equal(inc.datos.prioridad,null);assert.equal(inc.datos.tecnicoId,null);ok('Incidencia conserva desconocidos y contexto');
 const manualDatos={etiqueta:'Unidad candidata sintética',serial:'  Serie e\u0301A'+(process.env.REA08_NAMESPACE??'')+'  ',articuloId:null,referencia:'Observada fuera de diseño',evidencia:'Etiqueta física sintética'};
