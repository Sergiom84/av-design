 assert.equal((await repo.listar(F.autor,{salaId:F.sala})).registros.find(r=>r.id===visita.id)?.datos.intervalo,null);ok('Visita con horas desconocidas no fabrica duración');
 const [revDestino]=await sql`select id from revisiones_diseno where sala_id=${F.destino} limit 1`;
 const destino={...entrega,revisionId:revDestino.id,hitoId:F.entregaDestino,noRepresentado:true,motivoNoRepresentado:'Unidad observada trasladada fuera del diseño destino'};
 const traslado=await repo.ejecutar(F.autor,cmd('preparar_confirmacion',{base:b(activo),salaId:F.destino,entrega:destino,trasladar:true})) as {token:string};activo=await repo.ejecutar(F.autor,cmd('confirmar',{token:traslado.token})) as typeof activo;
 assert.equal((await repo.listar(F.autor,{salaId:F.sala})).registros.find(r=>r.id===ticket.id)?.salaId,F.sala);assert.equal((await repo.listar(F.autor,{salaId:F.destino})).registros.find(r=>r.id===activo.id)?.salaId,F.destino);ok('Traslado conservaUUID y ticket origen');
