 await writeFile(`${salida}/despues.json`,JSON.stringify(despues,null,2));await writeFile(`${salida}/sql-resultados.json`,JSON.stringify({checks,manualId:manual.id,ticketId:ticket.id,visitaId:visita.id,activoId:activo.id},null,2));
