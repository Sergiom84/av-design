 let conflicto:ErrorServicio|undefined;try{await repo.ejecutar(F.autor,cmd('manual',{salaId:F.sala,datos:{...manualDatos,serial:'SERIE ÉA'+(process.env.REA08_NAMESPACE??'')}}));}catch(e){conflicto=e as ErrorServicio;}assert.equal(conflicto?.status,409);assert.equal((conflicto?.detalle as {revisable:boolean}).revisable,true);ok('Serial NFC duplicado409 revisable');
 await fail(()=>repo.ejecutar(F.lectura,cmd('retirar',{base:b(activo),fecha:'2026-10-15',evidencia:'Prueba'})),403);ok('Lectura no escribe');
 const condiciones={titulo:'Acuerdo sintético QA',ambito:'sala',activos:[],desde:'2026-01-01',final:{tipo:'sin_fin_explicito'},incluidos:['diagnostico'],excluidos:['sustitucion'],condiciones:'Condición únicamente sintética',fuente:'QA08 explícita',referenciaTemporal:'apertura_registrada',primeraAtencion:{regla:'minutos_reales',cantidad:60,fuente:'QA08',origen:'apertura_registrada'},resolucion:null,archivado:false};
 const acuerdo=await repo.ejecutar(F.autor,cmd('acuerdo',{salaId:F.sala,entrega,datos:condiciones})) as typeof activo;
 const pa=await repo.ejecutar(F.autor,cmd('preparar_acuerdo',{incidencia:b(ticket),acuerdo:b(acuerdo),atenderFuera:false,notaFuera:null,limiteAtencion:null,limiteResolucion:null})) as {token:string};const ticket2=await repo.ejecutar(F.autor,cmd('aplicar_acuerdo',{token:pa.token})) as typeof activo;ok('Acuerdo exacto cobertura/SLA congelados');
 await fail(()=>repo.ejecutar(F.autor,cmd('incidencia',{base:b(ticket),transicion:'cerrar',sintoma:'Fallo',tipo:null,prioridad:null,tecnicoId:null,instante:null,evidencia:'Verificación'})),409);ok('CAS rechaza versión anterior');
