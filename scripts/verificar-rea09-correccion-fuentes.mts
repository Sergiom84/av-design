const antes = await fotografiarBase(sql), r = new RepositorioConsultas(sql);
const u = randomUUID(), sala = randomUUID(), articulo = randomUUID(), consumible = randomUUID(), cable = randomUUID(), bom = randomUUID(), equipoA = randomUUID(), equipoB = randomUUID(), puertoA = randomUUID(), puertoB = randomUUID(), conexion = randomUUID(), punto = randomUUID(), toma = randomUUID();
