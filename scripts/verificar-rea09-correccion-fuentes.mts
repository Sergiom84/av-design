    await bloqueada(c, tq, 'parametro-eliminado');
    if (parametroOriginal) await sql`insert into parametros(clave,valor,unidad,descripcion) values(${parametroOriginal.clave as string},${parametroOriginal.valor as string},${parametroOriginal.unidad as string | null},${parametroOriginal.descripcion as string | null})`;
    parametroTocado = false;
