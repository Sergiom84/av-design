    await sql`insert into puertos(id,articulo_id,nombre,sentido,senal,conector,total,fuente) values(${puertoA},${articulo},'HDMI OUT 1','salida','hdmi','HDMI A',1,'app'),(${puertoB},${articulo},'HDMI IN 1','entrada','hdmi','HDMI A',1,'app')`;
