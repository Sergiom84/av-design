    paso('BOM accesible modificada: histórica con3ud originales y anclas completas');
    await sql`delete from sala_material_bom where id=${bom}`;
    await bloqueada(c, t, 'bom-eliminada');
    queries.length = 0;
    await assert.rejects(() => r.preguntar(u, c.id, t.entrada), e => e instanceof ErrorConsulta && e.status === 409);
    assert(!contenido());
    paso('Reintento idempotente con BOM retirada:409 sin SELECT de contenido');
    const { versionAnclas: _anclas, ...anterior } = f;
    void _anclas;
    const identidad = await identidadConsulta(sql, u);
    await assert.rejects(() => autorizarMetadatosConsulta(sql, identidad, anterior), e => e instanceof ErrorConsulta && e.status === 409);
    paso('Metadatos anteriores sin anclas completas: denegados');

    const cc = await crear({ tipo: 'catalogo' }), tc = await preguntar(cc, 'Buscar catálogo');
    assert(tc.respuesta.citas.some(c => c.fuente.filas?.some(f => f.tabla === 'articulos' && f.id === consumible)));
    await sql`update articulos set descripcion='Descripción técnica modificada' where id=${consumible}`;
    const hc = await r.obtenerTurno(u, cc.id, tc.id);
