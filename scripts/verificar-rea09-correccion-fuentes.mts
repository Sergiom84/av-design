    }
    for (const id of conversaciones) await sql`delete from consultas_conversaciones where id=${id} and propietario_id=${u}`;
    await sql`delete from preferencias_usuario where usuario_id=${u}`;
    await sql`delete from salas where id=${sala}`;
    await sql`delete from articulos_tecnicos where articulo_id=${articulo}`;
