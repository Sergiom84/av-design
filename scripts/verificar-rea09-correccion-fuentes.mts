    assert.equal(campo('ru')?.valor, null); assert.equal(campo('ru')?.ausencia, 'sin_dato');
    assert.equal(campo('origen')?.valor, 'Fabricante corrección09'); assert.equal(campo('fecha')?.valor, '2026-10-15'); assert.equal(campo('url')?.valor, 'https://example.invalid/ficha09');
    assert.match(String(campo('verificado_en')?.valor), /^2026-10-16T/);
    assert(tf.respuesta.citas.some(c => c.fuente.filas?.some(f => f.tabla === 'articulos_tecnicos' && f.id === articulo)));
    assert(!propios.some(q => /\b(coste|precio|pvp|articulos_archivos_tecnicos|verificado_por)\b/i.test(q)));
    assert(!JSON.stringify(tf.respuesta).includes('987654'));
    await guardar('captura-ficha.json', tf); await guardar('sql-ficha.json', propios);
    paso('Ficha exacta530×310×80mm: procedencia/URL/fecha/verificación y ausencia RU, sin dinero/binarios');
    await sql`update articulos_tecnicos set ancho=531 where articulo_id=${articulo}`;
    const hf = await r.obtenerTurno(u, cc.id, tf.id);
    assert('historica' in hf && hf.historica && hf.respuesta.hechos.some(h => h.campo.endsWith('.ancho') && h.valor === 530));
    const nueva = await preguntar(cc, 'Ficha de catálogo', { tipo: 'catalogo', id: articulo });
    assert(nueva.respuesta.hechos.some(h => h.campo.endsWith('.ancho') && h.valor === 531));
