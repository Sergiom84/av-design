    await sql`insert into conexion_bocas(conexion_id,lado,equipo_id,puerto_id,ordinal) values(${conexion},'origen',${equipoA},${puertoA},1),(${conexion},'destino',${equipoB},${puertoB},1)`;
    await sql`insert into conexion_puntos_paso(id,conexion_id,orden,x_m,y_m,z_m) values(${punto},${conexion},0,2,1,2)`;
    await sql`insert into tomas_red(id,sala_id,codigo,ubicacion,x_m,y_m,z_m) values(${toma},${sala},'RED-COR09','pared',1,0,1)`;
    await sql`insert into preferencias_usuario(usuario_id,version,catalogo) values(${u},1,${sql.json({ marcas: [marca], q: '' })})`;
    await sql`insert into articulos_tecnicos(articulo_id,marca,modelo,ancho,alto,fondo,unidad,ru,origen,url,fecha,verificado_por) values(${articulo},${marca},${modelo},530,310,80,'mm',null,'Fabricante corrección09','https://example.invalid/ficha09','2026-10-15',${u})`;

    const c = await crear({ tipo: 'sala', id: sala }), t = await preguntar(c, '¿Qué material necesita?');
