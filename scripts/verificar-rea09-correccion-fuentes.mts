    assert(sinFicha.respuesta.hechos.some(h => h.etiqueta === 'Ficha técnica registrada' && h.ausencia === 'sin_dato'));
    paso('Nueva consulta sin ficha: ausencia explícita, sin dimensiones inventadas');

    const tp = await preguntar(c, '¿Cuántos metros calcula?');
