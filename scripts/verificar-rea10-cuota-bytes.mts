import assert from 'node:assert/strict';import {mkdir,readFile,writeFile} from 'node:fs/promises';import {resolve} from 'node:path';import {conectarRevisiones,idRequisito,SALIDA_REVISIONES} from './rea10-fixture.mjs';import {RepositorioRequisitos} from '../src/lib/requisitos/repositorio';import {LIMITES_REQUISITOS} from '../src/lib/requisitos/modelo';
const url=process.env.REA10_DATABASE_URL;if(!url)throw Error('URL sintética explícita obligatoria');const db=await conectarRevisiones(url),r=new RepositorioRequisitos(db),u=idRequisito(3);await mkdir(SALIDA_REVISIONES,{recursive:true});
try{
 const b=await readFile('output/rea-integracion/rea10/runtime-20261016/postgres-05/fuente-textual.pdf');const inicio=b.lastIndexOf(Buffer.from('\nxref\n'))+1,cola=b.subarray(inicio).toString('latin1'),ref=/startxref\s+(\d+)\s+%%EOF/u.exec(cola);assert.ok(ref);let relleno=LIMITES_REQUISITOS.archivo-b.length;for(let i=0;i<5;i++)relleno=LIMITES_REQUISITOS.archivo-b.length-(String(inicio+relleno).length-ref[1].length);const final=cola.replace(/startxref\s+\d+\s+%%EOF/u,`startxref\n${inicio+relleno}\n%%EOF`),espacios=Buffer.alloc(relleno,32);espacios[espacios.length-1]=10;const exacto=Buffer.concat([b.subarray(0,inicio),espacios,Buffer.from(final,'latin1')]);assert.equal(exacto.length,LIMITES_REQUISITOS.archivo);
 const codigo='PRUEBA-REA10-BYTES-'+Date.now();const [obra]=await db`insert into proyectos(nombre,codigo) values(${codigo},${codigo}) returning id`;const docs:Array<{id:string;sha256:string}>=[];const alta=()=>r.registrarArchivo(u,obra.id,{nombre:'limite-5MiB.pdf',mime:'application/pdf',tamano:exacto.length,procedencia:'Fuente sintética válida de 5 MiB exactos',fechaFuente:null,url:null},exacto);
 for(let i=0;i<19;i++)docs.push(await alta());const carrera=await Promise.allSettled([alta(),alta()]);assert.equal(carrera.filter(r=>r.status==='fulfilled').length,1);for(const r of carrera)if(r.status==='fulfilled')docs.push(r.value);const [total]=await db`select count(*)::int as documentos,sum(octet_length(c.bytes))::bigint as bytes from requisitos_documentos d join requisitos_contenidos c on c.documento_id=d.id where d.proyecto_id=${obra.id}`;assert.equal(total.documentos,20);assert.equal(Number(total.bytes),LIMITES_REQUISITOS.bytesObra);
 const original=await r.archivo(u,docs[0].id);assert.deepEqual(original.bytes,exacto);const extraccion=await r.extraer(u,docs[0].id,{modo:'local'});assert.equal(extraccion.resultado.estado,'con_texto');
 for(const d of docs)await r.retirar(u,d.id,{version:0,accion:'purgar',motivo:'Cierre de cuota sintética 100 MiB sin borrar tombstones',confirmarHash:d.sha256});const [resto]=await db`select coalesce(sum(octet_length(c.bytes)),0)::bigint as bytes from requisitos_documentos d join requisitos_contenidos c on c.documento_id=d.id where d.proyecto_id=${obra.id}`;assert.equal(Number(resto.bytes),0);
 await writeFile(resolve(SALIDA_REVISIONES,'resultado.json'),JSON.stringify({estado:'PASS',obraId:obra.id,originalBytes:exacto.length,cuotaBytes:Number(total.bytes),documentos:total.documentos,carreraGanadores:1,parserPaginas:extraccion.resultado.paginas.length,bytesTrasPurga:Number(resto.bytes),tombstones:docs.length},null,2));console.log('PASS originales5MiB exactos/descargaSHA/parserreal; 2altas concurrentes a95MiB producen1ganador y100MiB; purga explícita conserva20tombstones');
}finally{await db.end();}
