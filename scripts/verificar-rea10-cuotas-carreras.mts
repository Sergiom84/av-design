import assert from 'node:assert/strict';import {randomUUID} from 'node:crypto';import {mkdir,writeFile} from 'node:fs/promises';import {resolve} from 'node:path';
import {conectarRevisiones,fotografiarRevisiones,idRequisito,SALIDA_REVISIONES} from './rea10-fixture.mjs';import {RepositorioRequisitos} from '../src/lib/requisitos/repositorio';import {PlanesRequisitos} from '../src/lib/requisitos/planes';import {ErrorRequisito} from '../src/lib/requisitos/modelo';
const url=process.env.REA10_DATABASE_URL;if(!url)throw Error('URL sintética explícita obligatoria');const db=await conectarRevisiones(url),r=new RepositorioRequisitos(db),p=new PlanesRequisitos(db,'rea10-carreras-secreto-sintetico-local-2026'),u=idRequisito(3);const resultados:string[]=[];const ok=(s:string)=>{resultados.push(s);console.log('OK',s);};const fallo=async(fn:()=>Promise<unknown>,status:number)=>assert.rejects(fn,e=>e instanceof ErrorRequisito&&e.status===status);
await mkdir(SALIDA_REVISIONES,{recursive:true});
try{
 const antes=await fotografiarRevisiones(db);await writeFile(resolve(SALIDA_REVISIONES,'baseline.json'),JSON.stringify(antes,null,2));
 const codigo='PRUEBA-REA10-CUOTAS-'+Date.now();const [obra]=await db`insert into proyectos(nombre,codigo) values(${codigo},${codigo}) returning id`;const [loc]=await db`insert into localizaciones(proyecto_id,nombre) values(${obra.id},'Sin asignar') returning id`;const [sala]=await db`insert into salas(nombre,localizacion_id) values('Alfa',${loc.id}) returning id`;
 const archivo=Buffer.from('Sala: Alfa\nSala: Beta\n');const alta=()=>r.registrarArchivo(u,obra.id,{nombre:'fuente.txt',mime:'text/plain',tamano:archivo.length,procedencia:'Fixture cuotas sintética',fechaFuente:null,url:null},archivo);const doc=await alta(),x=await r.extraer(u,doc.id,{modo:'local'});
 const ab=await p.crear(u,{extraccionId:x.extraccionId,destino:'areas_bom'});const c=x.resultado.candidatos[0];const decisiones={versionModelo:1,destino:'areas_bom',areas:[{candidatoId:c.id,camposRevisados:['accion','nombre','codigo','localizacion','medidas','aceptarHomonimo'],motivo:'Nombre comprobado explícitamente',accion:'crear',salaId:null,nombre:'Alfa',codigo:null,localizacion:{id:loc.id,nombreNuevo:null},medidas:{largo_m:null,ancho_m:null,alto_m:null},aceptarHomonimo:false}],material:[],excluidos:[]};
 await p.editar(u,ab.id,{version:0,decisiones});await fallo(()=>p.preview(u,ab.id),409);ok('G05-homonimo-exige-decision');
 const [legado]=await db`insert into salas(nombre) values('Legado sintético sin obra') returning id`;await p.editar(u,ab.id,{version:1,decisiones:{...decisiones,areas:[{...decisiones.areas[0],accion:'vincular',salaId:legado.id}]}});await fallo(()=>p.preview(u,ab.id),409);ok('G05-no-adopta-legado');
 await p.editar(u,ab.id,{version:2,decisiones:{...decisiones,areas:[{...decisiones.areas[0],nombre:'Beta nueva'}]}});const pv=await p.preview(u,ab.id);await db`insert into hitos_proyecto(proyecto_id,tipo,notas) values(${obra.id},'cierre','Cierre sintético posterior al preview')`;const numero=(await db`select count(*)::int as n from salas where localizacion_id=${loc.id}`)[0].n;await assert.rejects(()=>p.confirmar(u,ab.id,{version:3,token:pv.token,clavePeticion:randomUUID()}));assert.equal((await db`select count(*)::int as n from salas where localizacion_id=${loc.id}`)[0].n,numero);ok('G11-cierre-tras-preview-sin-alta-parcial');
 // La cuota de planes se serializa para el propietario; las decisiones son inicialmente vacías.
 const cuotaCodigo=codigo+'-P';const [op]=await db`insert into proyectos(nombre,codigo) values(${cuotaCodigo},${cuotaCodigo}) returning id`;const dp=await r.registrarArchivo(u,op.id,{nombre:'planes.txt',mime:'text/plain',tamano:archivo.length,procedencia:'Cuota planes sintética',fechaFuente:null,url:null},archivo);const xp=await r.extraer(u,dp.id,{modo:'local'});
 const [abiertos]=await db`select count(*)::int as n from requisitos_planes where autor_id=${u} and estado='borrador'`;for(let i=abiertos.n;i<19;i++)await p.crear(u,{extraccionId:xp.extraccionId,destino:'areas_bom'});
 const dos=await Promise.allSettled([p.crear(u,{extraccionId:xp.extraccionId,destino:'areas_bom'}),p.crear(u,{extraccionId:xp.extraccionId,destino:'areas_bom'})]);assert.equal(dos.filter(x=>x.status==='fulfilled').length,1);assert.equal((await db`select count(*)::int as n from requisitos_planes where autor_id=${u} and estado='borrador'`)[0].n,20);ok('cuota20planes-carrera-un-ganador');
 await r.retirar(u,dp.id,{version:0,accion:'purgar',motivo:'Liberar borradores sintéticos de la cuota',confirmarHash:dp.sha256});
 // Documento100: sólo headers/bytes sintéticos y nuevos, ningún reset ni fuente real.
 const cq=codigo+'-D';const [oq]=await db`insert into proyectos(nombre,codigo) values(${cq},${cq}) returning id`;const docs=[];for(let i=0;i<99;i++)docs.push(await r.registrarArchivo(u,oq.id,{nombre:'cuota-'+i+'.txt',mime:'text/plain',tamano:1,procedencia:'Cuota sintética 100 documentos',fechaFuente:null,url:null},Buffer.from('x')));
 const nueva=()=>r.registrarArchivo(u,oq.id,{nombre:'limite.txt',mime:'text/plain',tamano:1,procedencia:'Carrera de cuota sintética',fechaFuente:null,url:null},Buffer.from('x'));const qdos=await Promise.allSettled([nueva(),nueva()]);assert.equal(qdos.filter(x=>x.status==='fulfilled').length,1);assert.equal((await db`select count(*)::int as n from requisitos_documentos where proyecto_id=${oq.id} and estado<>'purgado'`)[0].n,100);ok('cuota100documentos-carrera-un-ganador');
 for(const d of docs)await r.retirar(u,d.id,{version:0,accion:'purgar',motivo:'Cierre de cuota sintética conservando tombstone',confirmarHash:d.sha256});
 // Reversión de área sin BOM elimina sólo alta propia; una dependencia posterior la conserva.
 const ca=codigo+'-R';const [or]=await db`insert into proyectos(nombre,codigo) values(${ca},${ca}) returning id`;const [lr]=await db`insert into localizaciones(proyecto_id,nombre) values(${or.id},'Sin asignar') returning id`;const dr=await r.registrarArchivo(u,or.id,{nombre:'reversion.txt',mime:'text/plain',tamano:archivo.length,procedencia:'Reversión sintética',fechaFuente:null,url:null},archivo);const xr=await r.extraer(u,dr.id,{modo:'local'});
 const aplicar=async(candidatoId:string,nombre:string)=>{const plan=await p.crear(u,{extraccionId:xr.extraccionId,destino:'areas_bom'});await p.editar(u,plan.id,{version:0,decisiones:{...decisiones,areas:[{...decisiones.areas[0],candidatoId,nombre,localizacion:{id:lr.id,nombreNuevo:null}}]}});const preview=await p.preview(u,plan.id);return p.confirmar(u,plan.id,{version:1,token:preview.token,clavePeticion:randomUUID()});};
 const libre=await aplicar(xr.resultado.candidatos[0].id,'Alfa libre');await p.revertir(u,libre.id,{clavePeticion:randomUUID(),antecedenteId:null,motivo:'Retirar sólo alta sin dependencias'});assert.equal((await db`select id from salas where id=${libre.resultado.salasCreadas[0].id}`).length,0);
 const usada=await aplicar(xr.resultado.candidatos[1].id,'Beta usada');const salaUsada=usada.resultado.salasCreadas[0].id;await db`update salas set nombre='Edición ABA' where id=${salaUsada}`;await db`update salas set nombre='Beta usada' where id=${salaUsada}`;await db`insert into sala_equipos(sala_id,nombre,cantidad) values(${salaUsada},'Equipo sintético posterior',1)`;const rr=await p.revertir(u,usada.id,{clavePeticion:randomUUID(),antecedenteId:null,motivo:'Conservar edición ABA y diseño posterior'});assert.equal((await db`select id from salas where id=${salaUsada}`).length,1);assert.match(JSON.stringify(rr.resultado),/conservado/);ok('G12-reversion-alta-libre-y-ABA-dependencia-conservada');
 const despues=await fotografiarRevisiones(db);await writeFile(resolve(SALIDA_REVISIONES,'final.json'),JSON.stringify(despues,null,2));await writeFile(resolve(SALIDA_REVISIONES,'resultado.json'),JSON.stringify({resultados,antes:antes.sha256,despues:despues.sha256,salaOriginal:sala.id},null,2));
}finally{await db.end();}
