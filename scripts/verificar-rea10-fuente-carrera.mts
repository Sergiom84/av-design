import assert from 'node:assert/strict';import {randomUUID} from 'node:crypto';import {mkdir,writeFile} from 'node:fs/promises';import {resolve} from 'node:path';import PDFDocument from 'pdfkit';
import {conectarRevisiones,idRequisito,SALIDA_REVISIONES,fotografiarRevisiones} from './rea10-fixture.mjs';import {RepositorioRequisitos} from '../src/lib/requisitos/repositorio';import {PlanesRequisitos} from '../src/lib/requisitos/planes';import {guardarArchivoTecnico} from '../src/lib/catalogo-tecnico-repositorio';import {validarArchivoTecnicoCompleto} from '../src/lib/catalogo-tecnico';import {identidad} from '../src/lib/requisitos/fuentes';import {ErrorRequisito} from '../src/lib/requisitos/modelo';
const url=process.env.REA10_DATABASE_URL;if(!url)throw Error('URL sintética explícita obligatoria');const db=await conectarRevisiones(url),r=new RepositorioRequisitos(db),p=new PlanesRequisitos(db,'rea10-carrera-fuente-secreto-sintetico-2026'),yo=idRequisito(3);await mkdir(SALIDA_REVISIONES,{recursive:true});
const esperar=async(patron:string)=>{for(let i=0;i<200;i++){const filas=await db`select pid,wait_event_type,query from pg_stat_activity where datname=current_database() and pid<>pg_backend_pid() and wait_event_type='Lock' and query like ${'%'+patron+'%'}`;if(filas.length)return filas.map(f=>({pid:f.pid,wait:f.wait_event_type,query:f.query}));await new Promise(r=>setTimeout(r,10));}throw Error('No se observó barrera real: '+patron);};
try{
 const antes=await fotografiarRevisiones(db);await writeFile(resolve(SALIDA_REVISIONES,'baseline.json'),JSON.stringify(antes,null,2));const marca='PRUEBA-REA10-FUENTE-CARRERA-'+Date.now();const [obra]=await db`insert into proyectos(nombre,codigo) values(${marca},${marca}) returning id`;const [l]=await db`insert into localizaciones(proyecto_id,nombre) values(${obra.id},'Sin asignar') returning id`;const [a]=await db`insert into articulos(tipo,categoria,marca,modelo,unidad,fuente) values('equipo','QA',${marca},'Modelo exacto','ud','app') returning id`;
 const bytes=await new Promise<Buffer>(res=>{const d=new PDFDocument(),b:Buffer[]=[];d.on('data',c=>b.push(c));d.on('end',()=>res(Buffer.concat(b)));d.text('Sala: Alfa\nSala: Beta');d.end();});const archivo=await validarArchivoTecnicoCompleto(bytes,'application/pdf','ficha.pdf','ficha'),usuario={...await identidad(db,yo),debeCambiarClave:false};const procedencia={marca,modelo:'Modelo exacto',origen:'QA inicial',url:'https://example.invalid/ficha',fecha:'2026-10-15'};const archivoId=await guardarArchivoTecnico(db,usuario,a.id,procedencia,archivo);
 const preparar=async(nombre:string)=>{const [f]=await db`select revision_fuente from articulos_archivos_tecnicos where id=${archivoId}`;const doc=await r.registrarReferencia(yo,{proyectoId:obra.id,procedencia:'Referencia exacta QA carrera',referencia:{tipo:'ficha_e2',articuloId:a.id,archivoId,sha256:archivo.sha256,revisionFuente:String(f.revision_fuente)}});const ex=await r.extraer(yo,doc.id,{modo:'local'});const plan=await p.crear(yo,{extraccionId:ex.extraccionId,destino:'areas_bom'});await p.editar(yo,plan.id,{version:0,decisiones:{versionModelo:1,destino:'areas_bom',areas:[{candidatoId:ex.resultado.candidatos[0].id,camposRevisados:['accion','nombre','codigo','localizacion','medidas','aceptarHomonimo'],motivo:'Área nueva explícita sin BOM',accion:'crear',salaId:null,nombre,codigo:null,localizacion:{id:l.id,nombreNuevo:null},medidas:{largo_m:null,ancho_m:null,alto_m:null},aceptarHomonimo:false}],material:[],excluidos:[]}});const pv=await p.preview(yo,plan.id);return {doc,plan,pv};};
 // Orden1: escritor de origen ya posee artículo; confirmación espera y luego rechaza revisión nueva.
 const uno=await preparar('Alfa carrera origen primero');let liberar!:()=>void,listo!:()=>void;const barrera=new Promise<void>(r=>liberar=r),tomado=new Promise<void>(r=>listo=r);
 const escritor=db.begin(async tx=>{await tx`select id from articulos where id=${a.id} for update`;listo();await barrera;await tx`update articulos_archivos_tecnicos set origen='QA origen cambió primero' where id=${archivoId}`;});await tomado;
 const confirmar=p.confirmar(yo,uno.plan.id,{version:1,token:uno.pv.token,clavePeticion:randomUUID()}).then(value=>({value,error:null}),error=>({value:null,error}));const espera1=await esperar('select id from articulos order by id for update');liberar();await escritor;const rechazado=await confirmar;assert(rechazado.error instanceof ErrorRequisito);assert.equal(rechazado.error.status,409);assert.equal((await db`select id from salas where nombre='Alfa carrera origen primero' and localizacion_id=${l.id}`).length,0);
 // Orden2: confirmación posee artículos y espera una barrera en archivo. E2writer debe esperar artículo.
 const dos=await preparar('Beta carrera confirmación primero');let soltarArchivo!:()=>void,archivoTomado!:()=>void;const barreraArchivo=new Promise<void>(r=>soltarArchivo=r),archivoListo=new Promise<void>(r=>archivoTomado=r);
 const bloqueo=db.begin(async tx=>{await tx`select id from articulos_archivos_tecnicos where id=${archivoId} for update`;archivoTomado();await barreraArchivo;});await archivoListo;
 const confirma2=p.confirmar(yo,dos.plan.id,{version:1,token:dos.pv.token,clavePeticion:randomUUID()});const espera2=await esperar('articulos_archivos_tecnicos');let vioAplicacion=0;
 const actualizaDespues=db.begin(async tx=>{await tx`select id from articulos where id=${a.id} for update`;const [app]=await tx`select count(*)::int as n from requisitos_aplicaciones where plan_id=${dos.plan.id}`;vioAplicacion=app.n;await tx`update articulos_archivos_tecnicos set origen='QA origen cambió después' where id=${archivoId}`;});const espera3=await esperar('select id from articulos where id=');soltarArchivo();await bloqueo;const aplicada=await confirma2;await actualizaDespues;assert.equal(vioAplicacion,1);assert.equal((await db`select id from salas where nombre='Beta carrera confirmación primero' and localizacion_id=${l.id}`).length,1);assert.ok(aplicada.id);
 // Un origen cambiado no impide retirar su referencia sin recuperar el contenido ni tocar E2.
 await r.retirar(yo,dos.doc.id,{version:0,accion:'purgar',motivo:'Retirar referencia invalidada por el cambio de origen',confirmarHash:dos.doc.sha256});
 const despues=await fotografiarRevisiones(db);await writeFile(resolve(SALIDA_REVISIONES,'final.json'),JSON.stringify(despues,null,2));await writeFile(resolve(SALIDA_REVISIONES,'resultado.json'),JSON.stringify({estado:'PASS',esperaOrigenPrimero:espera1,esperaConfirmacionArchivo:espera2,esperaEscritorPosterior:espera3,aplicacionVistaDentroEscritor:vioAplicacion,aplicacionId:aplicada.id,sinTextoCopiado:true},null,2));console.log('PASS fuente primero409/0altas; confirmación primero1aplicación observada antes escritor; referencia inválida purgada sin tocar E2');
}finally{await db.end();}
