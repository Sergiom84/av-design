 const [articulo]=await db`insert into articulos(tipo,categoria,marca,modelo,unidad,fuente) values('equipo','Pantalla',${codigo},'QB65R','ud','app') returning id,revision`;
 const [variante]=await db`insert into articulos(tipo,categoria,marca,modelo,unidad,fuente) values('equipo','Pantalla',${codigo},'QB65R-B','ud','app') returning id`;
 const pdf=await new Promise<Buffer>(res=>{const partes:Buffer[]=[];const p=new PDFDocument({autoFirstPage:true});p.on('data',b=>partes.push(b));p.on('end',()=>res(Buffer.concat(partes)));p.text('Sala: Alfa\nSala: Beta\nárea común por definir\nModelo: QB65R\nPuerto: HDMI IN 1');p.end();});
 await writeFile(resolve(SALIDA_REVISIONES,'fuente-textual.pdf'),pdf);
 const documento=await repos.registrarArchivo(yo,obra.id,{nombre:'fuente-textual.pdf',mime:'application/pdf',tamano:pdf.length,procedencia:'PDF sintético local',fechaFuente:null,url:null},pdf);
 const descargado=await repos.archivo(yo,documento.id);assert.deepEqual(descargado.bytes,pdf);registrar('G04-original-sha',{sha256:hashBytes(pdf)});
 const extraccion=await repos.extraer(yo,documento.id,{modo:'local'});const c=extraccion.resultado.candidatos;
 assert.equal(c.filter(c=>c.original.sala).length,2);assert.equal(c.filter(c=>c.clase==='hipotesis').length,1);
 for(const x of c){const pagina=extraccion.resultado.paginas.find(p=>p.numero===x.ancla.pagina)!;assert.equal(pagina.texto.slice(x.ancla.inicio,x.ancla.fin),x.fragmento);}
 assert.equal((await db`select s.id from salas s join localizaciones l on l.id=s.localizacion_id where l.proyecto_id=${obra.id}`).length,0);registrar('G01-extraccion-sin-negocio');
 await rechaza(()=>repos.detalle(otro,documento.id),404);registrar('G10-B-no-lee');
 const alfa=c.find(c=>c.original.sala==='Alfa')!,modelo=c.find(c=>c.original.modelo==='QB65R')!;
 const plan=await planes.crear(yo,{extraccionId:extraccion.extraccionId,destino:'areas_bom'});
 const decisiones={versionModelo:1,destino:'areas_bom',areas:[{candidatoId:alfa.id,camposRevisados:['accion','nombre','codigo','localizacion','medidas','aceptarHomonimo'],motivo:'Alfa revisada',accion:'crear',salaId:null,nombre:'Alfa',codigo:null,localizacion:{id:loc.id,nombreNuevo:null},medidas:{largo_m:null,ancho_m:null,alto_m:null},aceptarHomonimo:false}],material:[{candidatoId:modelo.id,camposRevisados:['sala','articuloId','cantidad','unidad','disenoRevisado'],motivo:'Tres unidades adicionales verificadas',salaId:null,areaCandidatoId:alfa.id,articuloId:articulo.id,revisionArticulo:Number(articulo.revision),cantidad:3,unidad:'ud',disenoRevisado:true}],excluidos:[]};
 await planes.editar(yo,plan.id,{version:0,decisiones});
 const preview=await planes.preview(yo,plan.id);assert.equal(preview.diff.destino,'areas_bom');
 const confirmacion={version:1,token:preview.token,clavePeticion:randomUUID()};
 await assert.rejects(()=>planes.confirmar(yo,plan.id,confirmacion,{fallarTrasPrimerLote:true}));
 assert.equal((await db`select s.id from salas s join localizaciones l on l.id=s.localizacion_id where l.proyecto_id=${obra.id}`).length,0);registrar('G12-fallo-atomico');
 const resultadosCarrera=await Promise.allSettled([planes.confirmar(yo,plan.id,confirmacion),planes.confirmar(yo,plan.id,{...confirmacion,clavePeticion:randomUUID()})]);
 assert.equal(resultadosCarrera.filter(x=>x.status==='fulfilled').length,1);const aplicada=resultadosCarrera.find(x=>x.status==='fulfilled')!;if(aplicada.status!=='fulfilled')throw Error();const aplicacion=aplicada.value;
 const reintento=await planes.confirmar(yo,plan.id,confirmacion);assert.equal(reintento.id,aplicacion.id);await rechaza(()=>planes.confirmar(yo,plan.id,{...confirmacion,token:confirmacion.token+'x'}),409);registrar('G11-CAS-idempotencia');
 const [bom]=await db`select b.cantidad,b.articulo_id,s.sede_id,s.largo_m,s.ancho_m from sala_material_bom b join salas s on s.id=b.sala_id join localizaciones l on l.id=s.localizacion_id where l.proyecto_id=${obra.id}`;assert.equal(Number(bom.cantidad),3);assert.equal(bom.articulo_id,articulo.id);assert.notEqual(bom.articulo_id,variante.id);assert.equal(bom.sede_id,sede.id);assert.equal(Number(bom.largo_m),0);registrar('G05-G07-areas-bom-sin-equipos');
 const fuente=await leerFuenteRequisito(db,yo,documento.id,{proyectoId:obra.id,texto:true,extraccionId:extraccion.extraccionId,candidatoIds:[alfa.id]});assert.equal(fuente.hechos.length,1);
 const meta=await leerFuenteRequisito(db,yo,documento.id,{proyectoId:obra.id,texto:true});assert.equal(meta.hechos.length,0);registrar('G13-consulta-seleccionada');
 const reversion=await planes.revertir(yo,aplicacion.id,{clavePeticion:randomUUID(),antecedenteId:null,motivo:'Retirada sintética verificada'});assert.ok(reversion.id);
 await repos.retirar(yo,documento.id,{version:0,accion:'retirar',motivo:'Fin de gate',confirmarHash:documento.sha256});await rechaza(()=>repos.archivo(yo,documento.id),409);await rechaza(()=>autorizarMetadatosRequisito(db,yo,documento.id,{proyectoId:obra.id}),409);
 await repos.retirar(yo,documento.id,{version:1,accion:'purgar',motivo:'Purga sintética',confirmarHash:documento.sha256});const detalle=await repos.detalle(yo,documento.id);assert.equal(detalle.metadatos,null);assert.equal(detalle.extracciones.length,0);registrar('G13-retirada-purga');
 const despues=await fotografiarRevisiones(db);await writeFile(resolve(SALIDA_REVISIONES,'final.json'),JSON.stringify(despues,null,2));
 await writeFile(resolve(SALIDA_REVISIONES,'fixture.json'),JSON.stringify({codigo,obraId:obra.id,localizacionId:loc.id,articuloId:articulo.id,varianteId:variante.id,documentoId:documento.id,planId:plan.id,aplicacionId:aplicacion.id,usuarioId:yo},null,2));
 await writeFile(resolve(SALIDA_REVISIONES,'resultados.json'),JSON.stringify({resultados,antes:antes.sha256,despues:despues.sha256},null,2));
}finally{await db.end();}
