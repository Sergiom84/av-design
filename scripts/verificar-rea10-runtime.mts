import { leerFuenteRequisito,autorizarMetadatosRequisito } from '../src/lib/requisitos/consulta';
const url=process.env.REA10_DATABASE_URL;if(!url)throw new Error('REA10_DATABASE_URL explícita obligatoria.');
await mkdir(SALIDA_REVISIONES,{recursive:true});
const db=await conectarRevisiones(url);const resultados:unknown[]=[];
const registrar=(nombre:string,datos:unknown=true)=>{resultados.push({nombre,datos});console.log(nombre);};
const yo=idRequisito(1),otro=idRequisito(2);const repos=new RepositorioRequisitos(db);const planes=new PlanesRequisitos(db,'rea10-secreto-sintetico-de-prueba-2026-privado');
const rechaza=async(fn:()=>Promise<unknown>,estado:number)=>assert.rejects(fn,e=>e instanceof ErrorRequisito&&e.status===estado);
try{
 const antes=await fotografiarRevisiones(db);await writeFile(resolve(SALIDA_REVISIONES,'baseline.json'),JSON.stringify(antes,null,2));
 const codigo='PRUEBA-REA10-'+Date.now();const [sede]=await db`insert into sedes(nombre) values(${codigo}) returning id`;
 const [obra]=await db`insert into proyectos(nombre,codigo,sede_id) values(${codigo},${codigo},${sede.id}) returning id`;
